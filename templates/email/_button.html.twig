{# Centered email button - expects: url, label; showLink (fallback link, true by default) #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 26px 0 14px;">
    <tr>
        <td align="center">
            <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                    <td align="center" style="border-radius: 999px; background: #0E3A3F;">
                        <a href="{{ url }}" style="display: inline-block; padding: 15px 36px; font-size: 16px; font-weight: bold; color: #ffffff; text-decoration: none;">{{ label }} &rarr;</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
{% if showLink ?? true %}
    <p style="margin: 0; font-size: 12px; line-height: 1.5; color: #566461; text-align: center; word-break: break-all;">
        Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br>
        <a href="{{ url }}" style="color: #0E7C7B;">{{ url }}</a>
    </p>
{% endif %}
