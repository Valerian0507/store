{% extends 'email/_layout.html.twig' %}

{# Sent after the newsletter sign-up (NewsletterController) - expects: unsubscribeUrl #}
{% block title %}Un peu d'été dans votre boîte mail{% endblock %}
{% block preheader %}Merci pour votre inscription à la newsletter AquaSphère.{% endblock %}

{% block hero %}
    <img src="{{ absolute_url(asset('images/email/newsletter-hero.jpg')) }}" width="536" alt="Piscine au bord de la mer, à l'ombre d'un olivier" style="display: block; width: 100%; max-width: 536px; height: auto; border: 0; border-radius: 12px;">
    <h1 style="margin: 26px 0 0; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; font-weight: normal; line-height: 1.2; text-align: center; color: #0E3A3F;">{{ block('title') }}</h1>
    <div style="width: 70px; height: 2px; margin: 16px auto 26px; background: #C08A4E; line-height: 2px; font-size: 0;">&nbsp;</div>
{% endblock %}

{% block content %}
    <p style="margin: 0 0 12px; font-size: 18px; color: #0E3A3F;">Bonjour,</p>
    <p style="margin: 0; color: #3D4C4A;">
        Merci pour votre inscription ! Retrouvez nos inspirations, nos conseils d'entretien
        et nos nouveautés au fil des saisons.
    </p>

    {% include 'email/_button.html.twig' with {url: url('app_home') ~ '#home-advice', label: 'Découvrir nos conseils', showLink: false} %}

    {# What the newsletter contains #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 14px; background: #EEF2EC; border-radius: 12px;">
        <tr>
            {% for item in [
                {icon: 'sun', title: 'Inspirations', text: 'Des idées pour sublimer votre extérieur.'},
                {icon: 'leaf', title: 'Conseils', text: 'Nos astuces pour un bassin toujours au top.'},
                {icon: 'sparkles', title: 'Nouveautés', text: 'Nos équipements et sélections du moment.'},
            ] %}
                <td align="center" valign="top" width="33%" style="padding: 20px 10px; {{ not loop.first ? 'border-left: 1px solid #CFD9CB;' }}">
                    <img src="{{ absolute_url(asset('images/email/' ~ item.icon ~ '.png')) }}" width="44" height="44" alt="" style="display: block; margin: 0 auto 10px; border: 0;">
                    <p style="margin: 0 0 6px; font-family: Georgia, 'Times New Roman', serif; font-size: 19px; color: #0E3A3F;">{{ item.title }}</p>
                    <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #3D4C4A;">{{ item.text }}</p>
                </td>
            {% endfor %}
        </tr>
    </table>
{% endblock %}

{% block signature %}À très bientôt,<br>L'équipe AquaSphère{% endblock %}

{% block footer_note %}
    <p style="margin: 14px 0 0; font-size: 12px; color: rgba(247, 243, 236, 0.75);">
        Vous recevez cet e-mail suite à votre inscription à la newsletter.
        <a href="{{ unsubscribeUrl }}" style="color: #F7F3EC;">Se désinscrire</a>
    </p>
{% endblock %}
