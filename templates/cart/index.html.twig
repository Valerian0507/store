{# templates/cart/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon panier - AquaSphère{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/cart.css') }}">
{% endblock %}

{% block body %}
    {% set noImage = asset('images/products/no-image.jpg') %}
    {% set itemsCount = items|reduce((sum, item) => sum + item.qty, 0) %}

    <div class="aq-container cart-page">
        <nav aria-label="Fil d'Ariane">
            <ol class="cart-breadcrumb">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li aria-current="page">Mon panier</li>
            </ol>
        </nav>

        <header class="cart-head">
            <div>
                <h1 class="cart-head__title">Mon panier</h1>
                <p class="cart-head__subtitle">
                    {{ itemsCount > 0 ? itemsCount ~ ' article' ~ (itemsCount > 1 ? 's') ~ ' pour préparer vos beaux jours.' : 'Votre panier est vide pour le moment.' }}
                </p>
            </div>
            {% include 'cart/_steps.html.twig' with {step: 1} %}
        </header>

        {% if items is empty %}
            <section class="cart-card cart-empty">
                <i class="fa-solid fa-bag-shopping cart-empty__icon" aria-hidden="true"></i>
                <h2 class="cart-card__title">Votre panier est vide</h2>
                <p>Découvrez nos piscines, spas et accessoires pour profiter de chaque instant.</p>
                <a href="{{ path('app_products_index') }}" class="aq-btn aq-btn--primary">Découvrir le catalogue <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </section>
        {% else %}
            <div class="cart-layout">
                <section class="cart-card cart-items" aria-label="Articles du panier">
                    {% for item in items %}
                        {% set product = item.product %}
                        {% set productUrl = path('app_products_show', {id: product.id}) %}
                        <article class="cart-item">
                            <a href="{{ productUrl }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
                                <img src="{{ product.image ? asset('uploads/products/' ~ product.image) : noImage }}" alt="" width="200" height="150" loading="lazy"
                                     onerror="this.onerror=null;this.src='{{ noImage }}';">
                            </a>

                            <div class="cart-item__body">
                                <h2 class="cart-item__title"><a href="{{ productUrl }}">{{ product.title }}</a></h2>
                                <p class="cart-item__ref">Réf. {{ product.reference }}</p>

                                {% if product.stock >= item.qty %}
                                    <p class="cart-stock cart-stock--in">
                                        <span class="cart-stock__dot" aria-hidden="true"></span>
                                        <span><strong>En stock</strong> <small>{{ product.stock <= 5 ? 'Plus que ' ~ product.stock ~ ' disponible' ~ (product.stock > 1 ? 's') : 'Disponible immédiatement' }}</small></span>
                                    </p>
                                {% else %}
                                    <p class="cart-stock cart-stock--out">
                                        <span class="cart-stock__dot" aria-hidden="true"></span>
                                        <span><strong>Stock insuffisant</strong> <small>{{ product.stock > 0 ? 'Il ne reste que ' ~ product.stock ~ ' exemplaire' ~ (product.stock > 1 ? 's') : 'Produit en rupture de stock' }}</small></span>
                                    </p>
                                {% endif %}

                                <div class="cart-item__actions">
                                    {# Quantity: − / + limited to the stock (quantity_controller.js), sent with "Mettre à jour" #}
                                    <form method="post" action="{{ path('app_cart_update', {id: product.id}) }}" class="cart-item__update" data-turbo="false">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ product.id) }}">
                                        <div class="product-qty" data-controller="quantity">
                                            <button type="button" class="product-qty__btn" data-quantity-target="decrement" data-action="quantity#decrement" aria-label="Diminuer la quantité">
                                                <i class="fa-solid fa-minus" aria-hidden="true"></i>
                                            </button>
                                            <label class="visually-hidden" for="qty-{{ product.id }}">Quantité</label>
                                            <input class="product-qty__input" id="qty-{{ product.id }}" type="number" name="qty" value="{{ item.qty }}" min="1"
                                                   {% if product.stock > 0 %}max="{{ max(product.stock, 1) }}"{% endif %} inputmode="numeric"
                                                   data-quantity-target="input" data-action="change->quantity#clamp">
                                            <button type="button" class="product-qty__btn" data-quantity-target="increment" data-action="quantity#increment" aria-label="Augmenter la quantité">
                                                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <button type="submit" class="cart-link-btn">Mettre à jour</button>
                                    </form>

                                    <form method="post" action="{{ path('app_cart_remove', {id: product.id}) }}" class="cart-item__remove" data-turbo="false">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ product.id) }}">
                                        <button type="submit" class="cart-link-btn cart-link-btn--plain"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer</button>
                                    </form>
                                </div>
                            </div>

                            <div class="cart-item__prices">
                                <strong class="cart-item__total">{{ (item.lineTotalCents / 100)|number_format(2, ',', ' ') }} €</strong>
                                <span class="cart-item__unit">Prix unitaire <br>{{ (item.unitPriceCents / 100)|number_format(2, ',', ' ') }} €</span>
                            </div>
                        </article>
                    {% endfor %}

                    <a href="{{ path('app_products_index') }}" class="cart-continue"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Continuer mes achats</a>
                </section>

                <aside class="cart-side">
                    <section class="cart-card">
                        <h2 class="cart-card__title">Votre panier en résumé</h2>
                        {% include 'cart/_summary_totals.html.twig' with {itemsCount: itemsCount, subtotalCents: totalCents, totalCents: totalCents} %}
                        <a href="{{ path('app_checkout_index') }}" class="aq-btn aq-btn--primary aq-btn--block cart-cta">
                            Passer la commande <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>
                        <p class="cart-secure"><i class="fa-solid fa-lock" aria-hidden="true"></i> Paiement sécurisé via Stripe</p>
                    </section>

                    <p class="cart-perk">
                        <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
                        <span><strong>Livraison offerte</strong> en France métropolitaine</span>
                    </p>
                </aside>
            </div>
        {% endif %}

        <ul class="cart-trust">
            <li><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span><strong>Paiement sécurisé</strong>Carte bancaire via Stripe</span></li>
            <li><i class="fa-solid fa-truck-fast" aria-hidden="true"></i><span><strong>Livraison offerte</strong>en France métropolitaine</span></li>
            <li>
                <a href="mailto:alex.shaginyan0507@gmail.com" class="cart-trust__link">
                    <i class="fa-solid fa-headset" aria-hidden="true"></i><span><strong>Une question ?</strong>Contactez-nous</span>
                    <i class="fa-solid fa-arrow-right cart-trust__arrow" aria-hidden="true"></i>
                </a>
            </li>
        </ul>
    </div>
{% endblock %}
