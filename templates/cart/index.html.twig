{# templates/cart/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Panier{% endblock %}
{% block stylesheets %}
<style>
		.cart-page__title {
			margin-bottom: 1.5rem;
			font-size: 1.9rem;
			font-weight: 700;
			color: #10204a;
		}

		.cart-page__empty {
			padding: 1.25rem;
			border: 1px solid #e6e8ee;
			border-radius: 1rem;
			background: #fff;
		}

		.cart-list {
			display: block;
			background: #fff;
			border-radius: 1.25rem;
			overflow: hidden;
		}

		.cart-item {
			display: grid;
			grid-template-columns: 140px minmax(0, 1fr) 140px;
			gap: 1.25rem;
			align-items: start;
			padding: 1.25rem;
			border: 0;
			border-radius: 0;
			background: transparent;
			box-shadow: none;
		}


		.cart-item + .cart-item {
			border-top: 1px solid #edf0f5;
		}

		.cart-item__media-link {
			display: block;
			text-decoration: none;
		}

		.cart-item__media {
			display: flex;
			align-items: center;
			justify-content: center;
			height: 120px;
			border-radius: 0.9rem;
			background: #fff;
			overflow: hidden;
		}

		.cart-item__media img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			display: block;
		}

		.cart-item__title {
			margin: 0 0 0.5rem;
			font-size: 1.2rem;
			font-weight: 700;
			line-height: 1.3;
		}

		.cart-item__title-link {
			color: #10204a;
			text-decoration: none;
		}

		.cart-item__title-link:hover {
			text-decoration: underline;
		}

		.cart-item__price-line,
		.cart-item__qty-line,
		.cart-item__subtotal-line {
			margin: 0 0 0.35rem;
			color: #344054;
		}

		.cart-item__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.55rem;
			align-items: center;
			margin-top: 0.7rem;
		}

		.cart-item__update-form,
		.cart-item__remove-form {
			margin: 0;
		}

		.cart-item__update-form {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: center;
		}

		.cart-item__qty-control {
			display: grid;
			grid-template-columns: 32px 56px 32px;
			align-items: stretch;
			border: 1px solid #cfd4dc;
			border-radius: 999px;
			overflow: hidden;
			background: #fff;
		}

		.cart-item__qty-btn {
			height: 32px;
			border: 0;
			background: #fff;
			color: #10204a;
			font-size: 0.95rem;
			font-weight: 700;
			cursor: pointer;
			transition: background-color 0.15s ease;
		}

		.cart-item__qty-btn:hover {
			background: #f8f9fb;
		}

		.cart-item__qty-btn:first-child {
			border-right: 1px solid #cfd4dc;
		}

		.cart-item__qty-btn:last-child {
			border-left: 1px solid #cfd4dc;
		}

		.cart-item__qty-input {
			width: 100%;
			height: 32px;
			padding: 0;
			border: 0;
			border-radius: 0;
			background: #fff;
			text-align: center;
			font-size: 0.95rem;
		}


		.cart-item__qty-input::-webkit-outer-spin-button,
		.cart-item__qty-input::-webkit-inner-spin-button {
			-webkit-appearance: none;
			margin: 0;
		}

		.cart-item__qty-input[type=number] {
			-moz-appearance: textfield;
		}


		.cart-item__button,
		.cart-item__button--danger {
			padding: 0;
			border: 0;
			background: none;
			min-height: auto;
			border-radius: 0;
			font-weight: 500;
			cursor: pointer;
		}

		.cart-item__button {
			color: #10204a;
		}

		.cart-item__button--danger {
			color: #b42318;
		}

		.cart-item__button:hover,
		.cart-item__button--danger:hover {
			text-decoration: underline;
			background: none;
		}

		.cart-item__aside {
			text-align: right;
		}

		.cart-item__unit-price {
			margin: 0 0 0.5rem;
			color: #667085;
			font-size: 0.95rem;
		}

		.cart-item__line-total {
			margin: 0;
			font-size: 1.35rem;
			font-weight: 700;
			color: #0d1b3d;
		}

		.cart-summary {
			margin-top: 1.5rem;
			display: flex;
			justify-content: flex-end;
		}

		.cart-summary__box {
			width: 100%;
			max-width: 280px;
			padding: 1.25rem;
            text-align: end;
            border-top: 1px solid #edf0f5;
		}

		.cart-summary__total {
			margin: 0 0 1rem;
			font-size: 1.5rem;
			font-weight: 700;
			color: #10204a;
		}

		.cart-summary__checkout {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 80%;
			min-height: 46px;
			padding: 0.75rem 1rem;
			border-radius: 999px;
			background: #10204a;
			color: #fff;
			text-decoration: none;
			font-weight: 600;
		}

		.cart-summary__checkout:hover {
			background: #18306d;
			color: #fff;
		}

		@media(max-width: 991.98px) {
			.cart-item {
                grid-template-columns: 100px minmax(0, 1fr) 110px;
            }

			.cart-item__title {
                display: -webkit-box;
                -webkit-line-clamp: 1;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
		}

		@media(max-width: 767.98px) {
			.cart-page {
				padding: 1.5rem 0 2rem;
			}

			.cart-page__title {
				font-size: 2rem;
				margin-bottom: 1.2rem;
			}

			.cart-item {
				grid-template-columns: 1fr;
				gap: 1rem;
				padding: 1rem;
			}

			.cart-item__media {
				height: 180px;
			}

			.cart-item__update-form,
			.cart-item__actions {
				flex-direction: column;
				align-items: stretch;
			}

			.cart-item__qty-control {
				grid-template-columns: 42px 1fr 42px;
			}

			.cart-item__button,
			.cart-item__button--danger {
				width: 100%;
			}

			.cart-item__aside {
				padding-top: 0;
				border-top: 0;
			}
		}
	</style>
{% endblock %}

{% block body %}
	<section class="container py-4">
		<h1 class="cart-page__title">Panier</h1>

		{% if items is empty %}
			<div class="cart-page__empty">
				Votre panier est vide.
			</div>
		{% else %}
			<div class="cart-list">
				{% for item in items %}
					<article class="cart-item">
						<a href="{{ path('app_products_show', { id: item.product.id }) }}" class="cart-item__media-link">
							<div class="cart-item__media">
								{% if item.product.image %}
									<img src="{{ asset('uploads/products/' ~ item.product.image) }}" alt="{{ item.product.title }}" onerror="this.onerror=null;this.src='{{ asset('images/products/no-image.jpg') }}';">
								{% else %}
									<img src="{{ asset('images/products/no-image.jpg') }}" alt="No image">
								{% endif %}
							</div>
						</a>

						<div class="cart-item__content">
							<h2 class="cart-item__title">
								<a href="{{ path('app_products_show', { id: item.product.id }) }}" class="cart-item__title-link">
									{{ item.product.title }}
								</a>
							</h2>

							<p class="cart-item__price-line">
								Prix unitaire :
								{{ (item.unitPriceCents / 100)|number_format(2, ',', ' ') }}€
							</p>

							<p class="cart-item__qty-line">
								Quantité actuelle :
								{{ item.qty }}
							</p>

							<div class="cart-item__actions">
                                {# Formulaire de mise à jour avec protection CSRF #}
								<form method="post" action="{{ path('app_cart_update', { id: item.product.id }) }}" class="cart-item__update-form" data-turbo="false">
									<div class="cart-item__qty-control">
										<button type="button" class="cart-item__qty-btn" data-qty-action="decrease">−</button>
										<input type="number" name="qty" value="{{ item.qty }}" min="0" class="cart-item__qty-input">
										<button type="button" class="cart-item__qty-btn" data-qty-action="increase">+</button>
									</div>
									<input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.product.id) }}">
									<button type="submit" class="cart-item__button">
										Mettre à jour
									</button>
								</form>

                                {# Formulaire de suppression avec protection CSRF #}
								<form method="post" action="{{ path('app_cart_remove', { id: item.product.id }) }}" class="cart-item__remove-form" data-turbo="false">
									<input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.product.id) }}">
									<button type="submit" class="cart-item__button--danger">
										Supprimer
									</button>
								</form>
							</div>
						</div>
						<aside class="cart-item__aside">
							<p class="cart-item__unit-price">Prix</p>
							<p class="cart-item__line-total">
								{{ (item.lineTotalCents / 100)|number_format(2, ',', ' ') }}
								€
							</p>
						</aside>
					</article>
				{% endfor %}
			</div>

			<div class="cart-summary">
				<div class="cart-summary__box">
					<p class="cart-summary__total">
						Total :
						{{ (totalCents / 100)|number_format(2, ',', ' ') }}
						€
					</p>

					<a href="{{ path('app_checkout_index') }}" class="cart-summary__checkout">
						Passer au paiement
					</a>
				</div>
			</div>
		{% endif %}

	    <script>
			function bindCartQtyControls() {
    	        const controls = document.querySelectorAll('.cart-item__qty-control');

    	        controls.forEach(function (control) {
    	            if (control.dataset.qtyBound === '1') {
    	            return;
    	            }

        	        control.dataset.qtyBound = '1';

        	        const input = control.querySelector('.cart-item__qty-input');
        	        const decreaseButton = control.querySelector('[data-qty-action="decrease"]');
        	        const increaseButton = control.querySelector('[data-qty-action="increase"]');

        	        if (! input || ! decreaseButton || ! increaseButton) {
        	            return;
        	        }

        	        decreaseButton.addEventListener('click', function () {
            	        const currentValue = parseInt(input.value || '0', 10);
            	        const minValue = parseInt(input.min || '0', 10);

            	        if (currentValue > minValue) {input.value = currentValue - 1;
            	        }
        	        });

        	        increaseButton.addEventListener('click', function () {
            	        const currentValue = parseInt(input.value || '0', 10);
            	        input.value = currentValue + 1;
        	        });
    	        });
	        }

	        document.addEventListener('DOMContentLoaded', bindCartQtyControls);
	        document.addEventListener('turbo:load', bindCartQtyControls);
		</script>
{% endblock %}

