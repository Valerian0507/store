{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    <h1>Panier</h1>

    {% if items is empty %}
        <p>Votre panier est vide.</p>
    {% else %}
        {% for item in items %}
            <div style="margin-bottom: 20px; padding: 10px; border: 1px solid #ccc;">
                <div style="margin-bottom: 10px;">
                    {% if item.product.image %}
                        <img
                            src="{{ asset('uploads/products/' ~ item.product.image) }}"
                            alt="{{ item.product.title }}"
                            style="max-width: 120px;"
                            onerror="this.onerror=null;this.src='{{ asset('images/products/no-image.jpg') }}';"
                        >
                    {% else %}
                        <img
                            src="{{ asset('images/products/no-image.jpg') }}"
                            alt="No image"
                            style="max-width: 120px;"
                        >
                    {% endif %}
                </div>

                <p><strong>{{ item.product.title }}</strong></p>
                <p>Prix unitaire : {{ (item.unitPriceCents / 100)|number_format(2, ',', ' ') }} €</p>
                <p>Quantité actuelle : {{ item.qty }}</p>
                <p>Sous-total : {{ (item.lineTotalCents / 100)|number_format(2, ',', ' ') }} €</p>

                <form method="post" action="{{ path('app_cart_update', { id: item.product.id }) }}" style="margin-bottom: 10px;">
                    <input type="number" name="qty" value="{{ item.qty }}" min="0">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.product.id) }}">
                    <button type="submit">Mettre à jour</button>
                </form>

                <form method="post" action="{{ path('app_cart_remove', { id: item.product.id }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.product.id) }}">
                    <button type="submit">Supprimer</button>
                </form>
            </div>
        {% endfor %}

        <hr>
        <p><strong>Total : {{ (totalCents / 100)|number_format(2, ',', ' ') }} €</strong></p>
    {% endif %}
{% endblock %}
