{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/auth.css') }}">
{% endblock %}

{% block body %}
    <section class="container auth-page">
        <div class="auth-card">
            <h1 class="auth-card__title">Nouveau mot de passe</h1>
            <p class="auth-card__subtitle">Choisissez un nouveau mot de passe pour votre compte.</p>

            {{ form_start(resetForm, { attr: { 'data-turbo': 'false' } }) }}
                {{ form_errors(resetForm) }}

                <div class="auth-form__group">
                    {{ form_label(resetForm.plainPassword.first, 'Nouveau mot de passe', { label_attr: { class: 'auth-form__label' } }) }}
                    {{ form_widget(resetForm.plainPassword.first, { attr: { class: 'auth-form__input', placeholder: 'Votre nouveau mot de passe' } }) }}
                    {{ form_help(resetForm.plainPassword.first) }}
                    {{ form_errors(resetForm.plainPassword.first) }}
                </div>

                <div class="auth-form__group">
                    {{ form_label(resetForm.plainPassword.second, 'Confirmer le mot de passe', { label_attr: { class: 'auth-form__label' } }) }}
                    {{ form_widget(resetForm.plainPassword.second, { attr: { class: 'auth-form__input', placeholder: 'Répétez le mot de passe' } }) }}
                    {{ form_errors(resetForm.plainPassword.second) }}
                </div>

                <button class="auth-form__submit" type="submit">Réinitialiser</button>
            {{ form_end(resetForm) }}
        </div>
    </section>
{% endblock %}
