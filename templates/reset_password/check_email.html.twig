{% extends 'base.html.twig' %}

{% block title %}E-mail envoyé{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/auth.css') }}">
{% endblock %}

{% block body %}
    <section class="container auth-page">
        <div class="auth-card">
            <h1 class="auth-card__title">Vérifiez votre boîte mail</h1>
            <p class="auth-card__subtitle">
                Si un compte correspond à cette adresse, un e-mail contenant un lien de réinitialisation vient d'être envoyé.
                Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p class="auth-form__footer">
                Vous n'avez rien reçu ? Vérifiez vos spams ou
                <a href="{{ path('app_forgot_password_request') }}" class="auth-form__link">réessayez</a>.
            </p>
        </div>
    </section>
{% endblock %}
