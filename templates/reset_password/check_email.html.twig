{% extends 'base.html.twig' %}

{% block title %}E-mail envoyé{% endblock %}

{% block stylesheets %}
    <style>
        .auth-page {
            min-height: calc(100vh - 140px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 0;
        }

        .auth-card {
            width: 100%;
            max-width: 840px;
            padding: 2rem;
            border: 1px solid #e6e8ee;
            border-radius: 1.25rem;
            background: #fff;
            box-shadow: 0 10px 28px rgba(12, 28, 58, 0.08);
        }

        .auth-card__title {
            margin-bottom: 0.35rem;
            font-size: 1.9rem;
            font-weight: 700;
            color: #10204a;
            text-align: center;
        }

        .auth-card__subtitle {
            margin-bottom: 1.5rem;
            color: #667085;
            text-align: center;
        }

        .auth-form__group {
            margin-bottom: 1rem;
        }

        .auth-form__label {
            display: block;
            margin-bottom: 0.45rem;
            font-weight: 600;
            color: #344054;
        }

        .auth-form__input {
            width: 100%;
            height: 48px;
            padding: 0 0.95rem;
            border: 1px solid #d0d5dd;
            border-radius: 0.8rem;
            background: #fff;
            color: #101828;
            outline: none;
        }

        .auth-form__input:focus {
            border-color: #98a2b3;
            box-shadow: 0 0 0 3px rgba(48, 72, 128, 0.08);
        }

        .auth-form__checkbox {
            display: flex;
            align-items: flex-start;
            gap: 0.65rem;
            color: #344054;
        }

        .auth-form__checkbox input {
            margin-top: 0.2rem;
        }

        .auth-form__checkbox label {
            margin: 0;
            line-height: 1.5;
        }

        .auth-form__submit {
            width: 100%;
            margin-top: 1rem;
            min-height: 48px;
            border: 1px solid #10204a;
            border-radius: 999px;
            background: #10204a;
            color: #fff;
            font-weight: 600;
            cursor: pointer;
            transition: background-color .15s ease, border-color .15s ease, transform .1s ease;
        }

        .auth-form__submit:hover {
            background: #18306d;
            border-color: #18306d;
        }

        .auth-form__submit:active {
            transform: translateY(1px);
        }

        .auth-form__footer {
            margin-top: 1rem;
            text-align: center;
            color: #667085;
        }

        .auth-form__link {
            color: #304880;
            text-decoration: none;
        }

        .auth-form__link:hover {
            text-decoration: underline;
        }

        .auth-card .alert,
        .auth-card .invalid-feedback,
        .auth-card .form-error-message {
            border-radius: 0.9rem;
        }

        .auth-card ul {
            padding-left: 1.1rem;
            margin-bottom: 1rem;
            color: #b42318;
        }

        @media (max-width: 575.98px) {
            .auth-page {
                padding: 1rem 0;
                min-height: auto;
            }

            .auth-card {
                padding: 1.25rem;
                border-radius: 1rem;
            }

            .auth-card__title {
                font-size: 1.55rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="container auth-page">
        <div class="auth-card">
            <h1 class="auth-card__title">Vérifiez votre boîte mail</h1>
            <p class="auth-card__subtitle">
                Si un compte correspond à cette adresse, un e-mail contenant un lien de réinitialisation vient d'être envoyé.
                Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p class="auth-form__footer">
                Vous n'avez rien reçu ? Vérifiez vos spams ou
                <a href="{{ path('app_forgot_password_request') }}" class="auth-form__link">réessayez</a>.
            </p>
        </div>
    </section>
{% endblock %}
