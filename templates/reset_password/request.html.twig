{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Mot de passe oublié - AquaSphère{% endblock %}

{% block auth_content %}
    <p class="aq-kicker">Mot de passe oublié</p>
    <h1 class="auth__title">Pas de souci.</h1>
    <p class="auth__subtitle">Saisissez votre e-mail, nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>

    {{ form_start(requestForm, {attr: {class: 'auth-form', 'data-turbo': 'false'}}) }}
        <div class="auth-field">
            {{ form_label(requestForm.email, 'E-mail', {label_attr: {class: 'auth-field__label'}}) }}
            {{ form_widget(requestForm.email, {attr: {class: 'auth-field__input', placeholder: 'votre@email.com', autocomplete: 'email'}}) }}
            {{ form_errors(requestForm.email) }}
        </div>

        <button class="aq-btn aq-btn--primary aq-btn--block auth-form__submit" type="submit">
            Envoyer le lien <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
    {{ form_end(requestForm) }}

    <p class="auth__switch">
        <a href="{{ path('app_login') }}" class="auth__link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour à la connexion</a>
    </p>
{% endblock %}
