{% extends 'base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="mx-auto" style="max-width: 1100px;">
        <div class="mb-4">
            <h1 class="fw-bold mb-2">Mon Compte</h1>
            <p class="text-muted mb-0">
                Gérez vos commandes, adresses et profil.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="h4 mb-3">Mon Profil</h2>
                        <p class="text-muted flex-grow-1">
                            Affichez et modifiez les informations de votre profil.
                        </p>
                        <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">Gérer mon profil</a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="h4 mb-3">Mes Commandes</h2>
                        <p class="text-muted flex-grow-1">
                            Affichez l'historique de vos commandes, les statuts de suivi et les détails des commandes ouvertes.
                        </p>
                        <a href="{{ path('app_profile_orders') }}" class="btn btn-primary">
                            Voir mes commandes
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="h4 mb-3">Mes Adresses</h2>
                        <p class="text-muted flex-grow-1">
                            Gérez vos adresses de livraison pour un paiement plus rapide.
                        </p>
                        <a href="{{ path('app_profile_addresses') }}" class="btn btn-primary">
                            Voir mes adresses
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="h4 mb-3">Mes abonnements démo</h2>
                        <p class="text-muted flex-grow-1">Gérez vos plannings de réapprovisionnement : intervalle, quantité, pause ou annulation. Sans paiement ni livraison automatique.</p>
                        <a href="{{ path('app_care_plans') }}" class="aq-btn aq-btn--primary">Gérer mes plannings</a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4" id="newsletter">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="h4 mb-3">Newsletter</h2>
                        <p class="text-muted flex-grow-1">
                            {% if newsletterSubscribed %}
                                Vous recevez nos inspirations et conseils à l'adresse <strong>{{ user.email }}</strong>.
                            {% else %}
                                Vous n'êtes pas inscrit(e). Recevez nos inspirations et conseils au fil des saisons.
                            {% endif %}
                        </p>
                        <form method="post" action="{{ path('app_newsletter_account') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('newsletter_account') }}">
                            {% if newsletterSubscribed %}
                                <button type="submit" name="action" value="unsubscribe" class="aq-btn aq-btn--outline">Se désinscrire</button>
                            {% else %}
                                <button type="submit" name="action" value="subscribe" class="aq-btn aq-btn--primary">S'inscrire</button>
                            {% endif %}
                        </form>
                    </div>
                </div>
            </div>

            {# <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="h4 mb-3">Payment Methods</h2>
                        <p class="text-muted flex-grow-1">
                            Manage your saved payment methods securely through the payment provider.
                        </p>
                        <a href="{{ path('app_profile_payment_methods') }}" class="btn btn-outline-primary">
                            Go to payment methods
                        </a>
                    </div>
                </div>
            </div> #}
        </div>
    </div>
</div>
{% endblock %}
