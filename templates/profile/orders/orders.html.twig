{% extends 'profile/_layout.html.twig' %}

{% set accountTab = 'orders' %}

{% block title %}Mes commandes - AquaSphère{% endblock %}
{% block account_title %}Mes commandes{% endblock %}
{% block account_subtitle %}Retrouvez vos commandes et consultez leur statut.{% endblock %}
{% block account_help %}Une question sur une commande ?{% endblock %}

{% block account_content %}
    {% set statusLabels = {pending: 'En attente de paiement', paid: 'Payée', shipped: 'Expédiée', cancelled: 'Annulée'} %}

    {% if orders is empty %}
        <section class="account-card account-empty">
            <span class="account-card__icon" aria-hidden="true"><i class="fa-solid fa-box-open"></i></span>
            <h2 class="account-card__title">Aucune commande pour le moment</h2>
            <p class="account-card__lead">Vous n'avez encore passé aucune commande.</p>
            <a href="{{ path('app_products_index') }}" class="aq-btn aq-btn--primary">Découvrir le catalogue <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </section>
    {% else %}
        <div class="account-orders" role="table" aria-label="Mes commandes">
            <div class="account-orders__head" role="row">
                <span role="columnheader">Référence</span>
                <span role="columnheader">Date</span>
                <span role="columnheader">Statut</span>
                <span role="columnheader">Total</span>
                <span role="columnheader">Actions</span>
            </div>

            {% for order in orders %}
                <div class="account-order" role="row">
                    <span class="account-order__ref" role="cell" data-label="Référence">{{ order.reference ?? ('#' ~ order.id) }}</span>
                    <span role="cell" data-label="Date">{{ order.createdAt|date('d/m/Y') }}</span>
                    <span role="cell" data-label="Statut">
                        <span class="order-status order-status--{{ order.status }}">{{ statusLabels[order.status] ?? order.status|capitalize }}</span>
                    </span>
                    <span class="account-order__total" role="cell" data-label="Total">{{ (order.totalCents / 100)|number_format(2, ',', ' ') }} €</span>
                    <span class="account-order__actions" role="cell">
                        <a href="{{ path('app_profile_orders_show', {id: order.id}) }}" class="aq-btn aq-btn--outline aq-btn--sm">
                            Voir les détails <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>
                        {% if order.status == 'pending' %}
                            <a href="{{ path('app_checkout_pay', {id: order.id}) }}" class="aq-btn aq-btn--primary aq-btn--sm" data-turbo="false">
                                Finaliser le paiement <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                            </a>
                            <form method="post" action="{{ path('app_profile_orders_cancel', {id: order.id}) }}" data-turbo="false"
                                  onsubmit="return confirm('Annuler la commande {{ order.reference|e('js') }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ order.id) }}">
                                <button type="submit" class="aq-btn aq-btn--sm account-btn-danger">Annuler</button>
                            </form>
                        {% endif %}
                    </span>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
