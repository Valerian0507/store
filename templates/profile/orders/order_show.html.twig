{% extends 'profile/_layout.html.twig' %}

{% set accountTab = 'orders' %}
{% set noImage = asset('images/products/no-image.jpg') %}
{% set itemCount = order.items|reduce((sum, item) => sum + item.quantity, 0) %}
{# Prices include VAT, French VAT at 20 %: VAT part = total / 6 #}
{% set vatCents = (order.totalCents / 6)|round %}

{% block title %}Commande {{ order.reference }} - AquaSphère{% endblock %}
{% block account_title %}Détails de ma commande{% endblock %}
{% block account_subtitle %}
    {% set months = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
    <span class="account-hero__meta">
        {{ order.reference }} · {{ order.createdAt|date('j') }} {{ months[order.createdAt|date('n') - 1] }} {{ order.createdAt|date('Y') }}
        <span class="order-status order-status--{{ order.status }}">{{ order.statusLabel }}</span>
    </span>
{% endblock %}
{% block account_breadcrumb %}
    <li><a href="{{ path('app_profile_orders') }}">Mes commandes</a></li>
    <li aria-current="page">{{ order.reference }}</li>
{% endblock %}
{% block account_back %}
    <a href="{{ path('app_profile_orders') }}" class="account-hero__back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour à mes commandes
    </a>
{% endblock %}

{% block account_content %}
    {% if order.status == 'pending' %}
        <div class="account-toolbar">
            <a href="{{ path('app_checkout_pay', {id: order.orderId}) }}" class="aq-btn aq-btn--primary" data-turbo="false">
                Finaliser le paiement <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    {% endif %}

    <div class="account-order-detail">
        <section class="account-card">
            <h2 class="account-card__title">Articles de votre commande</h2>
            <p class="account-card__lead">{{ itemCount }} article{{ itemCount > 1 ? 's' }}</p>

            <div class="account-items" role="table" aria-label="Articles de la commande">
                <div class="account-items__head" role="row">
                    <span role="columnheader">Produit</span>
                    <span role="columnheader">Quantité</span>
                    <span role="columnheader">Prix unitaire</span>
                    <span role="columnheader">Total</span>
                </div>
                {% for item in order.items %}
                    <div class="account-item" role="row">
                        <span class="account-item__product" role="cell">
                            <img src="{{ item.imagePath ? asset('uploads/products/' ~ item.imagePath) : noImage }}" alt="" width="96" height="72" loading="lazy"
                                 onerror="this.onerror=null;this.src='{{ noImage }}';">
                            <span class="account-item__name">{{ item.productName }}</span>
                        </span>
                        <span role="cell" data-label="Quantité">{{ item.quantity }}</span>
                        <span role="cell" data-label="Prix unitaire">{{ (item.unitPriceCents / 100)|number_format(2, ',', ' ') }} €</span>
                        <span class="account-item__total" role="cell" data-label="Total">{{ (item.lineTotalCents / 100)|number_format(2, ',', ' ') }} €</span>
                    </div>
                {% endfor %}
            </div>
        </section>

        <div class="account-order-detail__side">
            <section class="account-card">
                <h2 class="account-card__title">Récapitulatif</h2>
                <dl class="account-summary">
                    <dt>Sous-total ({{ itemCount }} article{{ itemCount > 1 ? 's' }})</dt>
                    <dd>{{ (order.subtotalCents / 100)|number_format(2, ',', ' ') }} €</dd>
                    <dt>Livraison</dt>
                    <dd class="{{ order.shippingCents > 0 ? '' : 'account-summary__free' }}">{{ order.shippingCents > 0 ? (order.shippingCents / 100)|number_format(2, ',', ' ') ~ ' €' : 'Offerte' }}</dd>
                </dl>
                <div class="account-summary__total">
                    <span>Total TTC</span>
                    <strong>{{ (order.totalCents / 100)|number_format(2, ',', ' ') }} €</strong>
                    <small>TVA incluse ({{ (vatCents / 100)|number_format(2, ',', ' ') }} €)</small>
                </div>
            </section>

            <section class="account-card">
                <div class="account-card__head account-card__head--flush">
                    <span class="account-card__icon" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
                    <div>
                        <h2 class="account-card__title">Adresse de livraison</h2>
                        <address class="account-address__lines">
                            {{ order.shippingFullName }}<br>
                            {{ order.shippingStreet }}<br>
                            {{ order.shippingPostalCode }} {{ order.shippingCity }}<br>
                            {{ order.shippingCountry }}
                        </address>
                    </div>
                </div>
            </section>

            <aside class="account-help account-help--card">
                <i class="fa-regular fa-comment account-help__icon" aria-hidden="true"></i>
                <div>
                    <p>Une question sur cette commande ?</p>
                    <a href="mailto:alex.shaginyan0507@gmail.com?subject={{ ('Commande ' ~ order.reference)|url_encode }}" class="account-help__link">Contactez-nous <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </aside>
        </div>
    </div>
{% endblock %}

{# Help already in the right column #}
{% block account_aside %}{% endblock %}
