{% extends 'base.html.twig' %}

{% block title %}Order Details
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
			<div>
				<h1 class="h2 fw-bold mb-1">Détails de la Commande</h1>
				<p class="text-muted mb-0">
					Date:
					<span class="fw-semibold">{{ order.createdAt|date('d M Y') }}</span>
					| Reference:
					<span class="fw-semibold">{{ order.reference }}</span>
				</p>
			</div>

			<a href="{{ path('app_profile_orders') }}" class="btn btn-outline-secondary">
				Retour
			</a>
		</div>


		<div class="row g-4">
			<div class="col-12 col-lg-8">
				<div class="card shadow-sm border-0">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center mb-4">
							<h2 class="h4 mb-0">Articles</h2>
							<span class="text-muted small">{{ order.items|length }}
								article(s)</span>
						</div>

						<div class="d-flex flex-column gap-3">
							{% for item in order.items %}
								<div class="border rounded-3 p-3">
									<div class="row g-3 align-items-center">
										<div class="col-12 col-sm-3 col-md-2">
											{% if item.imagePath %}
												<div class="d-flex align-items-center justify-content-center overflow-hidden" style="height: 96px;">
													<img src="{{ asset('uploads/products/' ~ item.imagePath) }}"
                                                         alt="{{ item.productName }}"
                                                         class="img-fluid"
                                                         style="max-height: 100%; object-fit: contain;"
                                                         onerror="this.onerror=null;this.src='{{ asset('images/products/no-image.jpg') }}';">>
												</div>
											{% else %}
												<div class="d-flex align-items-center justify-content-center" style="height: 96px;">
													<span class="text-muted small">No image</span>
												</div>
											{% endif %}
										</div>

										<div class="col-12 col-sm-9 col-md-4">
											<div class="fw-semibold mb-1">{{ item.productName }}</div>
											<div class="text-muted small">
												Instantané de la commande
											</div>
										</div>

										<div class="col-4 col-md-2">
											<div class="text-muted small mb-1">Qty</div>
											<div class="fw-medium">{{ item.quantity }}</div>
										</div>

										<div class="col-4 col-md-2">
											<div class="text-muted small mb-1">Prix unitaire</div>
											<div>{{ (item.unitPriceCents / 100)|number_format(2, '.', ' ') }}
												€</div>
										</div>

										<div class="col-4 col-md-2 text-md-end">
											<div class="text-muted small mb-1">Total</div>
											<div class="fw-semibold">
												{{ (item.lineTotalCents / 100)|number_format(2, '.', ' ') }}
												€
											</div>
										</div>
									</div>
								</div>
							{% endfor %}
						</div>
					</div>
				</div>
			</div>

			<div class="col-12 col-lg-4">
				<div class="card shadow-sm border-0 mb-4">
					<div class="card-body">
						<h2 class="h5 mb-3">Récapitulatif de la Commande</h2>

						<div class="d-flex justify-content-between mb-2">
							<span class="text-muted">Total</span>
							<span>{{ (order.subtotalCents / 100)|number_format(2, '.', ' ') }}
								€</span>
						</div>

						<div class="d-flex justify-content-between mb-3">
							<span class="text-muted">Frais de livraison</span>
							<span>{{ (order.shippingCents / 100)|number_format(2, '.', ' ') }}
								€</span>
						</div>

						<hr>

						<div class="d-flex justify-content-between align-items-center">
							<span class="fw-semibold">Total</span>
							<span class="fs-5 fw-bold">
								{{ (order.totalCents / 100)|number_format(2, '.', ' ') }}
								€
							</span>
						</div>
					</div>
				</div>

				<div class="card shadow-sm border-0">
					<div class="card-body">
						<h2 class="h5 mb-3">Adresse de Livraison</h2>

						<div class="fw-semibold">{{ order.shippingFullName }}</div>
						<div>{{ order.shippingStreet }}</div>
						<div>{{ order.shippingPostalCode }}
							{{ order.shippingCity }}</div>
						<div>{{ order.shippingCountry }}</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
