{% extends 'profile/_layout.html.twig' %}

{% set accountTab = 'addresses' %}

{% block title %}{{ pageTitle }} - AquaSphère{% endblock %}
{% block account_title %}{{ pageTitle }}{% endblock %}
{% block account_subtitle %}{{ pageSubtitle }}{% endblock %}
{% block account_breadcrumb %}
    <li><a href="{{ path('app_profile_addresses') }}">Mes adresses</a></li>
    <li aria-current="page">{{ pageTitle }}</li>
{% endblock %}
{% block account_back %}
    <a href="{{ path('app_profile_addresses') }}" class="account-hero__back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour à mes adresses
    </a>
{% endblock %}

{% block account_content %}
    <div class="account-address-form">
        <section class="account-card">
            <header class="account-card__head">
                <span class="account-card__icon" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
                <div>
                    <h2 class="account-card__title">Adresse de livraison</h2>
                    <p class="account-card__lead">{{ pageSubtitle }}</p>
                </div>
            </header>

            {{ form_start(form, {attr: {class: 'account-form', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}

                <div class="account-field">
                    {{ form_label(form.country, null, {label_attr: {class: 'account-field__label'}}) }}
                    {{ form_widget(form.country, {attr: {class: 'account-input account-select', autocomplete: 'country-name'}}) }}
                    {{ form_errors(form.country) }}
                </div>

                <div class="account-field">
                    {{ form_label(form.street, null, {label_attr: {class: 'account-field__label'}}) }}
                    {{ form_widget(form.street, {attr: {class: 'account-input', placeholder: 'Ex. : 12 rue des Oliviers', autocomplete: 'street-address'}}) }}
                    {{ form_errors(form.street) }}
                </div>

                <div class="account-form__row">
                    <div class="account-field">
                        {{ form_label(form.postalCode, null, {label_attr: {class: 'account-field__label'}}) }}
                        {{ form_widget(form.postalCode, {attr: {class: 'account-input', placeholder: 'Ex. : 75001', autocomplete: 'postal-code', inputmode: 'numeric'}}) }}
                        {{ form_errors(form.postalCode) }}
                    </div>
                    <div class="account-field">
                        {{ form_label(form.city, null, {label_attr: {class: 'account-field__label'}}) }}
                        {{ form_widget(form.city, {attr: {class: 'account-input', placeholder: 'Ex. : Paris', autocomplete: 'address-level2'}}) }}
                        {{ form_errors(form.city) }}
                    </div>
                </div>

                <div class="account-form__actions">
                    <button type="submit" class="aq-btn aq-btn--primary">{{ submitLabel }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    <a href="{{ path('app_profile_addresses') }}" class="aq-btn aq-btn--outline">Annuler</a>
                </div>
            {{ form_end(form) }}
        </section>

        <aside class="account-card account-card--sage">
            <header class="account-card__head">
                <span class="account-card__icon account-card__icon--light" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
                <h2 class="account-card__title">Pour vos prochaines commandes</h2>
            </header>
            <p class="account-card__text">Retrouvez cette adresse au moment de la livraison, lors de votre commande.</p>
            <p class="account-card__text account-card__text--ruled">Vous pourrez la modifier ou la supprimer à tout moment depuis votre compte.</p>
        </aside>
    </div>
{% endblock %}

{% block account_aside %}{% endblock %}
