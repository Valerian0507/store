{% extends 'profile/_layout.html.twig' %}

{% set accountTab = 'addresses' %}

{% block title %}Mes adresses - AquaSphère{% endblock %}
{% block account_title %}Mes adresses{% endblock %}
{% block account_subtitle %}Gérez vos adresses de livraison enregistrées.{% endblock %}

{% block account_content %}
    {% set ownerName = (app.user.firstName ~ ' ' ~ app.user.lastName)|trim %}

    <div class="account-toolbar">
        <a href="{{ path('app_profile_addresses_new') }}" class="aq-btn aq-btn--primary">
            <i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter une adresse
        </a>
    </div>

    <div class="account-addresses">
        {# Adresse par défaut en premier #}
        {% for address in addresses|sort((a, b) => b.isDefault <=> a.isDefault) %}
            <article class="account-card account-address">
                <div class="account-address__main">
                    <span class="account-card__icon" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
                    <div>
                        <span class="account-address__badge {{ address.isDefault ? 'is-default' }}">
                            {{ address.isDefault ? 'Adresse par défaut' : 'Adresse enregistrée' }}
                        </span>
                        <h2 class="account-address__name">{{ ownerName ?: 'Mon adresse' }}</h2>
                        <address class="account-address__lines">
                            {{ address.street }}<br>
                            {{ address.postalCode }} {{ address.city }}<br>
                            {{ address.country }}
                        </address>
                        <p class="account-address__date">Ajoutée le {{ address.createdAt|date('d/m/Y') }}</p>
                    </div>
                </div>

                <footer class="account-address__actions">
                    <a href="{{ path('app_profile_addresses_edit', {id: address.id}) }}" class="aq-btn aq-btn--outline aq-btn--sm">
                        <i class="fa-solid fa-pen" aria-hidden="true"></i> Modifier
                    </a>
                    {% if not address.isDefault %}
                        <form method="post" action="{{ path('app_profile_addresses_set_default', {id: address.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('set_default_address_' ~ address.id) }}">
                            <button type="submit" class="account-link-btn"><i class="fa-regular fa-star" aria-hidden="true"></i> Définir par défaut</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('app_profile_addresses_delete', {id: address.id}) }}"
                          onsubmit="return confirm('Supprimer cette adresse ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_address_' ~ address.id) }}">
                        <button type="submit" class="account-link-btn account-link-btn--danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer</button>
                    </form>
                </footer>
            </article>
        {% endfor %}

        {# Carte d'ajout, toujours en dernier #}
        <a href="{{ path('app_profile_addresses_new') }}" class="account-address-add">
            <span class="account-card__icon" aria-hidden="true"><i class="fa-solid fa-plus"></i></span>
            <strong>Ajouter une adresse</strong>
            <span>{{ addresses is empty ? 'Enregistrez une adresse pour commander plus rapidement.' : 'Enregistrez une nouvelle adresse de livraison.' }}</span>
            <span class="aq-link-arrow">Créer une adresse <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        </a>
    </div>

{% endblock %}

{% block account_aside %}
    <p class="account-note">
        <i class="fa-solid fa-box-open" aria-hidden="true"></i>
        <span>Vos adresses sont disponibles lors de la commande.</span>
    </p>
{% endblock %}
