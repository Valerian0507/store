{% extends 'admin/adminBase.html.twig' %}

{% block title %}Orders{% endblock %}

{% block admin_content %}
<div class="container">
    {% set statusLabels = {
        'pending': 'En attente de paiement',
        'paid': 'Payée',
        'shipped': 'Expédiée',
        'cancelled': 'Annulée'
    } %}

    {% set statusBadgeClasses = {
        'pending': 'bg-warning text-dark',
        'paid': 'bg-success text-white',
        'shipped': 'bg-primary text-white',
        'cancelled': 'bg-danger text-white'
    } %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Orders</h1>
    </div>

    {% if orders is empty %}
        <div class="alert alert-info">Aucune commande enregistrée.</div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Client</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for order in orders %}
                            <tr>
                                <td class="fw-semibold">{{ order.reference }}</td>
                                <td>{{ order.user ? order.user.email : '—' }}</td>
                                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <span class="badge {{ statusBadgeClasses[order.status] ?? 'bg-secondary text-white' }}">
                                        {{ statusLabels[order.status] ?? order.status|capitalize }}
                                    </span>
                                </td>
                                <td class="text-end">
                                    {{ (order.totalCents / 100)|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('admin_orders_show', { id: order.id }) }}" class="btn btn-sm btn-primary">
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
