{% extends 'admin/adminBase.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block admin_content %}
    {% set filters = {status: selectedStatus, search: search}|filter(v => v is not null) %}

    <header class="admin-page-head admin-page-head--actions">
        <div>
            <h1 class="admin-page-head__title">Commandes</h1>
            <p class="admin-page-head__subtitle">Consultez et traitez les commandes de vos clients.</p>
            <p class="admin-page-head__counts">
                <span>{{ allOrders }} commande{{ allOrders > 1 ? 's' }}</span>
                {% if pendingOrders > 0 %}
                    <a href="{{ path('admin_orders_index', {status: 'pending'}) }}" class="admin-page-head__alert">
                        {{ pendingOrders }} en attente de paiement
                    </a>
                {% endif %}
            </p>
        </div>
        <div class="admin-page-head__actions">
            <a href="{{ path('admin_dashboard') }}" class="admin-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour au tableau de bord</a>
        </div>
    </header>

    <form method="get" action="{{ path('admin_orders_index') }}" class="admin-panel admin-filters admin-filters--labeled" role="search">
        <label class="admin-field">
            <span class="admin-field__label">Statut</span>
            <select name="status" class="admin-filters__select">
                <option value="">Tous les statuts</option>
                {% for statusValue, statusLabel in statusLabels %}
                    <option value="{{ statusValue }}" {{ selectedStatus == statusValue ? 'selected' }}>{{ statusLabel }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="admin-field admin-field--grow">
            <span class="admin-field__label">Recherche</span>
            <span class="admin-filters__search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" name="search" value="{{ search }}" placeholder="Référence ou e-mail client">
            </span>
        </label>
        <div class="admin-filters__buttons">
            <button type="submit" class="aq-btn aq-btn--primary">Filtrer</button>
            <a href="{{ path('admin_orders_index') }}" class="aq-btn aq-btn--outline">Réinitialiser</a>
        </div>
    </form>

    <section class="admin-panel">
        <div class="admin-table-wrap">
            <table class="admin-table admin-table--scroll">
                <thead>
                    <tr>
                        <th scope="col">Référence</th>
                        <th scope="col">Client</th>
                        <th scope="col">Date</th>
                        <th scope="col">Statut</th>
                        <th scope="col" class="admin-table__num">Total</th>
                        <th scope="col" class="admin-table__actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td><a href="{{ path('admin_orders_show', {id: order.id}) }}" class="admin-table__title">{{ order.reference }}</a></td>
                            <td>
                                {% if order.user %}
                                    <span class="admin-table__ellipsis" title="{{ order.user.email }}">{{ order.user.email }}</span>
                                {% else %}-{% endif %}
                            </td>
                            <td class="admin-table__muted">{{ order.createdAt|date('d/m/Y') }}<span class="admin-table__time"> {{ order.createdAt|date('H:i') }}</span></td>
                            <td>{% include 'admin/_partials/_order_status.html.twig' with {status: order.status} %}</td>
                            <td class="admin-table__num">{{ (order.totalCents / 100)|number_format(2, ',', ' ') }} €</td>
                            <td class="admin-table__actions">
                                <a href="{{ path('admin_orders_show', {id: order.id}) }}" class="admin-action">
                                    Voir<span class="admin-action__more"> les détails</span> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="admin-table__empty">Aucune commande trouvée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <footer class="admin-panel__foot">
            <span>{{ totalOrders }} commande{{ totalOrders > 1 ? 's' }}{{ filters is not empty ? ' (filtrées)' }}</span>
            {% include 'admin/_partials/_pagination.html.twig' with {route: 'admin_orders_index', params: filters, page: currentPage, pages: totalPages} %}
        </footer>
    </section>
{% endblock %}
