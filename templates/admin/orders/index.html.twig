{% extends 'admin/adminBase.html.twig' %}

{% block title %}Orders{% endblock %}

{% block stylesheets %}
<style>
    .catalog-pagination-wrap {
        display: flex;
        justify-content: center;
    }

    .catalog-pagination {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .catalog-pagination-item {
        display: flex;
    }

    .catalog-pagination-link {
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 50%;
        border: 1px solid #cfd4dc;
        background: #fff;
        color: #1b1f23;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .catalog-pagination-link:hover {
        border-color: #102a63;
        color: #102a63;
        text-decoration: none;
    }

    .catalog-pagination-item.is-active .catalog-pagination-link {
        background: #102a63;
        border-color: #102a63;
        color: #fff;
    }

    .catalog-pagination-item.is-disabled .catalog-pagination-link {
        opacity: 0.45;
        pointer-events: none;
        cursor: default;
    }

    .catalog-pagination-arrow {
        font-size: 1.4rem;
        line-height: 1;
    }
</style>
{% endblock %}

{% block admin_content %}
<div class="container py-4">
    {% set statusBadgeClasses = {
        'pending': 'bg-warning text-dark',
        'paid': 'bg-success text-white',
        'shipped': 'bg-primary text-white',
        'cancelled': 'bg-danger text-white'
    } %}

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2 fw-bold mb-1">Commandes</h1>

        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
            Retour au tableau de bord
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('admin_orders_index') }}" class="row g-3 align-items-end">
                <div class="col-12 col-md-4 col-lg-2">
                    <label for="status" class="form-label">Statut</label>
                    <select name="status" id="status" class="form-select">
                        <option value="">Tous les statuts</option>

                        {% for statusValue, statusLabel in statusLabels %}
                            <option value="{{ statusValue }}" {{ selectedStatus == statusValue ? 'selected' : '' }}>
                                {{ statusLabel }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md">
                    <label for="search" class="form-label">Recherche</label>
                    <input
                        type="text"
                        name="search"
                        id="search"
                        class="form-control"
                        value="{{ search ?? '' }}"
                        placeholder="Référence ou email client"
                    >
                </div>

                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Filtrer
                    </button>

                    <a href="{{ path('admin_orders_index') }}" class="btn btn-outline-secondary ms-2">
                        Réinitialiser
                    </a>
                </div>
            </form>
        </div>
    </div>

    {% if orders is empty %}
        <div class="alert alert-info">
            Aucune commande trouvée.
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Client</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for order in orders %}
                            <tr>
                                <td class="fw-semibold">{{ order.reference }}</td>
                                <td>{{ order.user ? order.user.email : '—' }}</td>
                                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <span class="badge {{ statusBadgeClasses[order.status] ?? 'bg-secondary text-white' }}">
                                        {{ statusLabels[order.status] ?? order.status|capitalize }}
                                    </span>
                                </td>
                                <td class="text-end">
                                    {{ (order.totalCents / 100)|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('admin_orders_show', { id: order.id }) }}" class="btn btn-sm btn-outline-primary">
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {% if totalPages > 1 %}
            <nav class="catalog-pagination-wrap mt-4" aria-label="Pagination commandes">
                <ul class="catalog-pagination">
                    <li class="catalog-pagination-item {{ currentPage <= 1 ? 'is-disabled' : '' }}">
                        <a
                            class="catalog-pagination-link catalog-pagination-arrow"
                            href="{{ path('admin_orders_index', {
                                page: currentPage - 1,
                                status: selectedStatus,
                                search: search
                            }) }}"
                            aria-label="Page précédente"
                        >
                            ‹
                        </a>
                    </li>

                    {% for pageNumber in 1..totalPages %}
                        <li class="catalog-pagination-item {{ currentPage == pageNumber ? 'is-active' : '' }}">
                            <a
                                class="catalog-pagination-link"
                                href="{{ path('admin_orders_index', {
                                    page: pageNumber,
                                    status: selectedStatus,
                                    search: search
                                }) }}"
                            >
                                {{ pageNumber }}
                            </a>
                        </li>
                    {% endfor %}

                    <li class="catalog-pagination-item {{ currentPage >= totalPages ? 'is-disabled' : '' }}">
                        <a
                            class="catalog-pagination-link catalog-pagination-arrow"
                            href="{{ path('admin_orders_index', {
                                page: currentPage + 1,
                                status: selectedStatus,
                                search: search
                            }) }}"
                            aria-label="Page suivante"
                        >
                            ›
                        </a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
