{# templates/admin/adminBase.html.twig - site header + admin sidebar + content #}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Admin{% endblock %} - AquaSphère</title>
        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="48x48">
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&family=Parisienne&display=swap">

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://kit.fontawesome.com/bc43524f66.js" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        {% endblock %}

        {# After importmap: the admin and page CSS come after Bootstrap and app.css #}
        <link rel="stylesheet" href="{{ asset('styles/pages/admin.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>

    <body class="admin">
        {% include '_partials/_navbar.html.twig' %}
        {% include '_partials/_flash.html.twig' %}

        <div class="admin-shell">
            {% include 'admin/_partials/_nav.html.twig' %}

            <main class="admin-main">
                {% block body %}
                    {% block admin_content %}{% endblock %}
                {% endblock %}
            </main>
        </div>

        {% include 'admin/_partials/_footer.html.twig' %}

        <script>
            document.addEventListener('click', function (e) {
            const btn = e.target.closest('.js-delete-image');
            if (!btn) return;

            e.preventDefault();

            const form = btn.closest('form');
            const action = btn.dataset.action;

            Swal.fire({
                title: 'Supprimer l’image ?',
                text: "Cette action est irréversible.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Oui, supprimer',
                cancelButtonText: 'Annuler'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.action = action;
                    form.method = 'post';
                    form.submit();
                }
            });
        });
        </script>

    </body>
</html>
