{% extends 'admin/adminBase.html.twig' %}

{% block title %}Admin · New product{% endblock %}

{% block admin_content %}
<div class="container py-4">
    <h1>Créer un produit</h1>

    {# {{ form_start(form) }} #}
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
    {{ form_errors(form) }}

    {{ form_row(form.reference) }}
    {{ form_row(form.category) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.volumeM3) }}
    {{ form_row(form.weightKg) }}
    {{ form_row(form.priceCents) }}
    {{ form_row(form.image, { help: 'Charger image (JPG/PNG/WEBP).' }) }}

    <button class="btn btn-primary">Créer</button>
    <a class="btn btn-link" href="{{ path('admin_products_index') }}">Retour</a>

    {{ form_end(form) }}
</div>
{% endblock %}
