{% extends 'admin/adminBase.html.twig' %}

{% block title %}Admin · Produits{% endblock %}

{% block admin_content %}
<div class="container py-4">
    <h1 class="h2 fw-bold mb-3">Produits</h1>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <a class="btn btn-primary" href="{{ path('admin_products_new') }}">Créer un produit</a>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
            Retour au tableau de bord
        </a>
    </div>

    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>ID</th>
            <th>Référence</th>
            <th>Catégorie</th>
            <th>Titre</th>
            <th class="text-end">Prix</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for p in products %}
            <tr>
                <td>{{ p.id }}</td>
                <td>{{ p.reference }}</td>
                <td>{{ p.category }}</td>
                <td>{{ p.title }}</td>
                <td class="text-end">{{ (p.priceCents / 100) | number_format(2, '.', ' ') }}</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       href="{{ path('admin_products_edit', {id: p.id}) }}">Modifier</a>

                    <form method="post"
                          action="{{ path('admin_products_delete', {id: p.id}) }}"
                          style="display:inline"
                          onsubmit="return confirm('Supprimer ce produit?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ p.id) }}">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">No products.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
