{% extends 'admin/adminBase.html.twig' %}

{% block title %}Modifier le produit{% endblock %}

{% block admin_content %}
    <nav aria-label="Fil d'Ariane">
        <ol class="admin-breadcrumb">
            <li><a href="{{ path('admin_dashboard') }}">Administration</a></li>
            <li><a href="{{ path('admin_products_index') }}">Produits</a></li>
            <li aria-current="page">{{ product.title }}</li>
        </ol>
    </nav>

    <header class="admin-page-head admin-page-head--actions">
        <div>
            <h1 class="admin-page-head__title">Modifier le produit</h1>
            <p class="admin-page-head__subtitle">Réf. {{ product.reference }} · n° {{ product.id }}</p>
        </div>
        <div class="admin-page-head__actions">
            <a href="{{ path('app_products_show', {id: product.id}) }}" class="admin-back" target="_blank" rel="noopener">
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Voir sur la boutique
            </a>
            <a href="{{ path('admin_products_index') }}" class="admin-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour aux produits</a>
        </div>
    </header>

    {% include 'admin/products/_form.html.twig' with {submitLabel: 'Enregistrer les modifications'} %}
{% endblock %}
