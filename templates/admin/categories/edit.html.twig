{% extends 'admin/adminBase.html.twig' %}

{% block title %}Modifier la catégorie{% endblock %}

{% block admin_content %}
    <nav aria-label="Fil d'Ariane">
        <ol class="admin-breadcrumb">
            <li><a href="{{ path('admin_dashboard') }}">Administration</a></li>
            <li><a href="{{ path('admin_categories_index') }}">Catégories</a></li>
            <li aria-current="page">{{ category.label|capitalize }}</li>
        </ol>
    </nav>

    <header class="admin-page-head admin-page-head--actions">
        <div>
            <h1 class="admin-page-head__title">Modifier la catégorie</h1>
            <p class="admin-page-head__subtitle">{{ category.label|capitalize }}</p>
        </div>
        <div class="admin-page-head__actions">
            <a href="{{ path('admin_categories_index') }}" class="admin-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour aux catégories</a>
        </div>
    </header>

    {% include 'admin/categories/_form.html.twig' with {
        submitLabel: 'Enregistrer les modifications',
        submitIcon: 'fa-solid fa-check',
        productCount: category.products|length,
        noteIcon: 'fa-solid fa-circle-info',
        note: 'Le nom sera mis à jour dans le menu et le catalogue de la boutique.',
    } %}
{% endblock %}
