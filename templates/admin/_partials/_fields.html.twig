{# Admin form fields: label (asterisk if required), widget, help, errors #}
{% macro field(field, placeholder = null, attr = {}, help = null) %}
    {% set widgetAttr = {class: 'admin-input'}|merge(placeholder ? {placeholder: placeholder} : {})|merge(attr) %}
    <div class="admin-field">
        {{ form_label(field, null, {label_attr: {class: 'admin-field__label'}}) }}
        {{ form_widget(field, {attr: widgetAttr}) }}
        {% if help %}<p class="admin-field__help">{{ help }}</p>{% endif %}
        {{ form_errors(field) }}
    </div>
{% endmacro %}
