{# templates/_partials/_navbar.html.twig #}
{% set route = app.request.attributes.get('_route') %}
{% set currentCategory = app.request.query.get('category') %}
{# 5xx error page (errorSafeMode): no database query -> "Catalogue" link instead of the categories, cart not counted #}
{% set safeMode = errorSafeMode ?? false %}
{% set navCategories = safeMode ? [] : nav_categories() %}

<header class="site-header">
    <div class="aq-container site-header__bar">
        {# Burger: mobile and tablet only #}
        <button class="site-header__icon site-header__toggle" type="button"
                data-bs-toggle="collapse" data-bs-target="#siteMenu"
                aria-controls="siteMenu" aria-expanded="false" aria-label="Ouvrir le menu">
            <i class="fa-solid fa-bars"></i>
        </button>

        <a class="site-header__brand" href="{{ path('app_home') }}">
            {% include '_partials/_logo.html.twig' %}
        </a>

        {# Active link from the current route and category #}
        <nav class="site-header__nav" aria-label="Navigation principale">
            {% for category in navCategories %}
                <a class="site-header__link {{ route == 'app_products_index' and currentCategory == category.id ? 'is-active' : '' }}"
                   href="{{ path('app_products_index', {category: category.id}) }}">
                    {{ category.label|capitalize }}
                </a>
            {% else %}
                <a class="site-header__link" href="{{ path('app_products_index') }}">Catalogue</a>
            {% endfor %}
        </nav>

        <div class="site-header__actions">
            <form class="site-search site-header__search" method="get" action="{{ path('app_products_index') }}" role="search">
                <label class="visually-hidden" for="site-search-desktop">Rechercher un produit</label>
                <input class="site-search__input" id="site-search-desktop" type="search" name="q"
                       value="{{ route == 'app_products_index' ? app.request.query.get('q') : '' }}"
                       placeholder="Rechercher un produit…" maxlength="80">
                <button class="site-search__button" type="submit" aria-label="Rechercher">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>

            {% if is_granted('ROLE_ADMIN') %}
                <a class="site-header__icon site-header__account {{ route starts with 'admin_' ? 'is-active' : '' }}" href="{{ path('admin_dashboard') }}" title="Administration" aria-label="Administration">
                    <i class="fa-solid fa-gauge"></i>
                </a>
            {% endif %}

            {% if app.user %}
                <a class="site-header__icon site-header__account" href="{{ path('app_profile_index') }}" title="Mon compte ({{ app.user.firstName }})" aria-label="Mon compte">
                    <i class="fa-regular fa-user"></i>
                </a>
            {% endif %}

            {# Badge updated without reload by cart_add_controller.js #}
            {% set cartCount = safeMode ? 0 : cart_count() %}
            <a class="site-header__icon site-header__cart {{ route starts with 'app_cart_' ? 'is-active' : '' }}" href="{{ path('app_cart_index') }}" title="Panier"
               aria-label="{{ cartCount > 0 ? 'Panier (' ~ cartCount ~ ' article' ~ (cartCount > 1 ? 's' : '') ~ ')' : 'Panier' }}" data-cart-link>
                <i class="fa-solid fa-bag-shopping"></i>
                <span class="site-header__badge" data-cart-count aria-hidden="true" {{ cartCount == 0 ? 'hidden' }}>{{ cartCount > 99 ? '99+' : cartCount }}</span>
            </a>

            {# Login / logout always last: the icon shows the action, not the state #}
            {% if app.user %}
                <form class="site-header__account" method="POST" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="site-header__icon" title="Déconnexion" aria-label="Déconnexion">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    </button>
                </form>
            {% else %}
                <a class="site-header__icon site-header__account {{ route == 'app_login' ? 'is-active' : '' }}" href="{{ path('app_login') }}" title="Connexion" aria-label="Connexion">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                </a>
            {% endif %}
        </div>
    </div>

    {# Mobile dropdown menu #}
    <div class="collapse site-menu" id="siteMenu">
        <div class="aq-container site-menu__inner">
            <form class="site-search" method="get" action="{{ path('app_products_index') }}" role="search">
                <label class="visually-hidden" for="site-search-mobile">Rechercher un produit</label>
                <input class="site-search__input" id="site-search-mobile" type="search" name="q" placeholder="Rechercher un produit…" maxlength="80">
                <button class="site-search__button" type="submit" aria-label="Rechercher">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>

            <nav class="site-menu__links" aria-label="Navigation mobile">
                <a href="{{ path('app_products_index') }}">Tous les produits</a>
                {% for category in navCategories %}
                    <a href="{{ path('app_products_index', {category: category.id}) }}">{{ category.label|capitalize }}</a>
                {% endfor %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_dashboard') }}">Admin</a>
                {% endif %}
            </nav>

            <div class="site-menu__account">
                {% if app.user %}
                    <a href="{{ path('app_profile_index') }}"><i class="fa-regular fa-user"></i> Mon compte</a>
                    <form method="POST" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Déconnexion</button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}"><i class="fa-solid fa-arrow-right-to-bracket"></i> Connexion</a>
                    <a href="{{ path('app_register') }}"><i class="fa-solid fa-user-plus"></i> Inscription</a>
                {% endif %}
            </div>
        </div>
    </div>
</header>
