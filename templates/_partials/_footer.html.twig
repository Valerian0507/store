{# templates/_partials/_footer.html.twig #}
<footer class="site-footer">
	<div class="aq-container">
		<div class="site-footer__grid">
			<div class="site-footer__about">
				<a href="{{ path('app_home') }}">
					{% include '_partials/_logo.html.twig' with {variant: 'light'} %}
				</a>
				<p class="site-footer__tagline">
					Des piscines, des spas et des équipements pour profiter pleinement de votre extérieur, aujourd'hui et pour longtemps.
				</p>
				<ul class="site-footer__social">
					<li>
						<a href="https://www.linkedin.com/in/oleksii-chahinian" target="_blank" rel="noopener" aria-label="LinkedIn">
							<i class="fa-brands fa-linkedin"></i>
						</a>
					</li>
					<li>
						<a href="https://github.com/Valerian0507" aria-label="GitHub">
							<i class="fa-brands fa-github"></i>
						</a>
					</li>
					<li>
						<a href="mailto:alex.shaginyan0507@gmail.com" aria-label="E-mail">
							<i class="fa-solid fa-envelope"></i>
						</a>
					</li>
				</ul>
			</div>

			<div>
				<h2 class="site-footer__title">Nos univers</h2>
				<ul class="site-footer__links">
					{# 5xx error page (errorSafeMode): no database query #}
					{% for category in (errorSafeMode ?? false) ? [] : nav_categories() %}
						<li>
							<a href="{{ path('app_products_index', {category: category.id}) }}">{{ category.label|capitalize }}</a>
						</li>
					{% else %}
						<li>
							<a href="{{ path('app_products_index') }}">Catalogue</a>
						</li>
					{% endfor %}
				</ul>
			</div>

			<div>
				<h2 class="site-footer__title">Mon compte</h2>
				<ul class="site-footer__links">
					{% if app.user %}
						<li>
							<a href="{{ path('app_profile_index') }}">Mon profil</a>
						</li>
						<li>
							<a href="{{ path('app_profile_orders') }}">Mes commandes</a>
						</li>
					{% else %}
						<li>
							<a href="{{ path('app_login') }}">Connexion</a>
						</li>
						<li>
							<a href="{{ path('app_register') }}">Inscription</a>
						</li>
					{% endif %}
					<li>
						<a href="{{ path('app_cart_index') }}">Mon panier</a>
					</li>
				</ul>
			</div>

			<div>
				<h2 class="site-footer__title">Informations</h2>
				<ul class="site-footer__links">
					<li>
						<a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
					</li>
					<li>
						<a href="{{ path('app_cgv') }}">CGV</a>
					</li>
					<li>
						<a href="{{ path('app_politique_confidentialite') }}">Confidentialité</a>
					</li>
				</ul>
			</div>

			{# Olive tree + motto (decorative image, the text stays readable) #}
			<div class="site-footer__signature">
				<img class="site-footer__tree" src="{{ asset('images/icons/olive-tree-footer.webp') }}"
					 alt="" width="433" height="420" loading="lazy">
				<p class="site-footer__motto">Plus qu'une piscine,<br>un art de vivre.</p>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p>© {{ "now"|date("Y") }} AquaSphère. Tous droits réservés.</p>
			<p>Projet réalisé à des fins pédagogiques (formation TP DWWM). Aucune vente réelle - les produits présentés ne sont pas commercialisés.</p>
		</div>
	</div>
</footer>
