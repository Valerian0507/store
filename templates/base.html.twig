{# templates/base.html.twig - template parent de toute l'application #}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}AquaSphère{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>AW</text></svg>">

        {% block stylesheets %} {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://kit.fontawesome.com/bc43524f66.js" crossorigin="anonymous"></script>
        {% endblock %}
    </head>
    <body>
        {% include '_partials/_navbar.html.twig' %}
        {% include '_partials/_flash.html.twig' %}

        {% block body %}{% endblock %}

        {% include '_partials/_footer.html.twig' %}
    </body>
</html>



