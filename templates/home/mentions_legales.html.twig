{% extends 'home/_legal_layout.html.twig' %}

{% set legalPage = 'mentions' %}
{% set legalNumbers = 'large' %}
{% set legalSections = [
    {id: 'editeur', title: 'Éditeur du site'},
    {id: 'hebergement', title: 'Hébergement'},
    {id: 'propriete', title: 'Propriété intellectuelle'},
    {id: 'contact', title: 'Contact'},
] %}

{% block legal_title %}Mentions légales{% endblock %}
{% block legal_intro %}Les informations relatives au site AquaSphère.{% endblock %}

{% block section_editeur %}
    <dl class="legal-facts">
        <dt>Éditeur :</dt>
        <dd>Oleksii Chahinian</dd>
        <dt>Coordonnées :</dt>
        <dd><a href="mailto:alex.shaginyan0507@gmail.com">alex.shaginyan0507@gmail.com</a> - 07 78 64 57 15</dd>
        <dt>Directeur de la publication :</dt>
        <dd>Oleksii Chahinian</dd>
    </dl>
    <p>
        Le site AquaSphère est un projet personnel réalisé pendant la formation
        Développeur Web et Web Mobile (TP DWWM).
    </p>
{% endblock %}

{# TO FILL IN at deployment (art. 6 of French law n° 2004-575 of 21 June 2004, LCEN):
