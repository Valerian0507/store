        <dt>Adresse :</dt>
        <dd><mark class="legal-todo">[adresse postale complète de l'hébergeur]</mark></dd>
        <dt>Téléphone :</dt>
        <dd><mark class="legal-todo">[numéro de téléphone de l'hébergeur]</mark></dd>
        <dt>Site web :</dt>
        <dd><mark class="legal-todo">[site web de l'hébergeur]</mark></dd>
