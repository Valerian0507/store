{% extends 'email/_layout.html.twig' %}

{% set icon = 'envelope-check' %}
{% set noteIcon = 'question' %}

{% block title %}Confirmez votre adresse e-mail{% endblock %}
{% block preheader %}Un dernier clic pour activer votre compte AquaSphère.{% endblock %}

{% block content %}
    <p style="margin: 0 0 12px; text-align: center; font-size: 18px; color: #0E3A3F;">Bonjour{{ firstName|default('') ? ' ' ~ firstName }},</p>
    <p style="margin: 0; text-align: center; color: #3D4C4A;">
        Bienvenue chez AquaSphère. Pour activer votre compte, confirmez votre adresse e-mail.
    </p>

    {% include 'email/_button.html.twig' with {url: signedUrl, label: 'Confirmer mon adresse e-mail'} %}

    <p style="margin: 16px 0 0; text-align: center; font-size: 13px; color: #566461;">
        Ce lien est valable pendant {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
    </p>
{% endblock %}

{% block note %}
    <strong>Vous n'êtes pas à l'origine de cette demande ?</strong><br>
    Ignorez cet e-mail : aucun compte ne sera activé.
{% endblock %}
