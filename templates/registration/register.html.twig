{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/auth.css') }}">
{% endblock %}

{% block body %}
    <section class="container auth-page">
        <div class="auth-card">
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
            {% endfor %}

            <h1 class="auth-card__title">Créer un compte</h1>
            <p class="auth-card__subtitle">Inscrivez-vous pour accéder à la boutique.</p>

            {{ form_start(registrationForm, {
                attr: { 'data-turbo': 'false' }
            }) }}
                {{ form_errors(registrationForm) }}

                <div class="auth-form__group">
                    {{ form_label(registrationForm.lastName, 'Nom', {
                        label_attr: { class: 'auth-form__label' }
                    }) }}
                    {{ form_widget(registrationForm.lastName, {
                        attr: {
                            class: 'auth-form__input',
                            placeholder: 'Votre nom',
                            autocomplete: 'family-name'
                        }
                    }) }}
                    {{ form_errors(registrationForm.lastName) }}
                </div>

                <div class="auth-form__group">
                    {{ form_label(registrationForm.firstName, 'Prénom', {
                        label_attr: { class: 'auth-form__label' }
                    }) }}
                    {{ form_widget(registrationForm.firstName, {
                        attr: {
                            class: 'auth-form__input',
                            placeholder: 'Votre prénom',
                            autocomplete: 'given-name'
                        }
                    }) }}
                    {{ form_errors(registrationForm.firstName) }}
                </div>

                <div class="auth-form__group">
                    {{ form_label(registrationForm.email, 'E-mail', {
                        label_attr: { class: 'auth-form__label' }
                    }) }}
                    {{ form_widget(registrationForm.email, {
                        attr: {
                            class: 'auth-form__input',
                            placeholder: 'Votre e-mail',
                            autocomplete: 'email'
                        }
                    }) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="auth-form__group">
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                        label_attr: { class: 'auth-form__label' }
                    }) }}
                    {{ form_widget(registrationForm.plainPassword, {
                        attr: {
                            class: 'auth-form__input',
                            placeholder: 'Votre mot de passe',
                            autocomplete: 'new-password'
                        }
                    }) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                <div class="auth-form__checkbox">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms,"J'accepte les conditions générales") }}
                </div>
                {{ form_errors(registrationForm.agreeTerms) }}

                <button type="submit" class="auth-form__submit">Créer mon compte</button>
            {{ form_end(registrationForm) }}

            <p class="auth-form__footer">
                Vous avez déjà un compte ?
                <a href="{{ path('app_login') }}" class="auth-form__link">Connectez-vous</a>
            </p>
        </div>
    </section>
{% endblock %}
