{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Renvoyer l'e-mail de vérification - AquaSphère{% endblock %}

{% block auth_content %}
    <p class="aq-kicker">Activation du compte</p>
    <h1 class="auth__title">Renvoyer l'e-mail de vérification.</h1>
    <p class="auth__subtitle">Saisissez l'adresse de votre compte : nous vous enverrons un nouveau lien d'activation.</p>

    {{ form_start(form, {attr: {class: 'auth-form'}}) }}
        <div class="auth-field">
            {{ form_label(form.email, 'E-mail', {label_attr: {class: 'auth-field__label'}}) }}
            {{ form_widget(form.email, {attr: {class: 'auth-field__input', placeholder: 'votre@email.com', autocomplete: 'email'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <button type="submit" class="aq-btn aq-btn--primary aq-btn--block auth-form__submit">
            Envoyer le lien <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
    {{ form_end(form) }}

    <p class="auth__switch">
        <a href="{{ path('app_login') }}" class="auth__link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour à la connexion</a>
    </p>
{% endblock %}
