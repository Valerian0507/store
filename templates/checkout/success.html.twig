{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.reference }} - AquaSphère{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/cart.css') }}">
{% endblock %}

{% block body %}
    {% set noImage = asset('images/products/no-image.jpg') %}
    {% set itemsCount = order.items|reduce((sum, item) => sum + item.quantity, 0) %}
    {% set isPaid = order.status in ['paid', 'shipped'] %}

    <div class="aq-container cart-page">
        <section class="cart-card success">
            {# Steps: all completed once paid #}
            <div class="success__steps">
                {% include 'cart/_steps.html.twig' with {step: isPaid ? 4 : 3} %}
            </div>

            <header class="success__hero">
                {% if isPaid %}
                    <span class="success-hero__icon" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                    <h1 class="cart-head__title">Merci pour votre commande !</h1>
                    <p class="cart-head__subtitle">Votre paiement a été confirmé.</p>
                {% else %}
                    <span class="success-hero__icon success-hero__icon--pending" aria-hidden="true"><i class="fa-regular fa-clock"></i></span>
                    <h1 class="cart-head__title">Commande enregistrée</h1>
                    <p class="cart-head__subtitle">Le paiement n'a pas encore été confirmé : vous pouvez le finaliser maintenant ou depuis « Mes commandes ».</p>
                {% endif %}
                <span class="success__demo"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Mode démonstration</span>
            </header>

            <dl class="success-meta">
                <div><dt>Référence de commande</dt><dd>{{ order.reference }}</dd></div>
                <div><dt>Date de commande</dt><dd>{{ order.createdAt|date('d/m/Y') }}</dd></div>
                <div><dt>Statut</dt><dd><span class="success-meta__status success-meta__status--{{ order.status }}">{{ order.statusLabel }}</span></dd></div>
                <div><dt>Total TTC</dt><dd>{{ (order.totalCents / 100)|number_format(2, ',', ' ') }} €</dd></div>
            </dl>

            <div class="success__grid">
                <section class="success__box">
                    <h2 class="success__title">Articles commandés ({{ itemsCount }})</h2>
                    <ul class="success-items">
                        {% for item in order.items %}
                            <li class="success-item">
                                <img src="{{ item.imagePath ? asset('uploads/products/' ~ item.imagePath) : noImage }}" alt="" width="140" height="100" loading="lazy"
                                     onerror="this.onerror=null;this.src='{{ noImage }}';">
                                <span class="success-item__info">
                                    <span class="success-item__name">{{ item.productName }}</span>
                                    {% if item.reference %}<small>Réf. {{ item.reference }}</small>{% endif %}
                                </span>
                                <span class="success-item__qty" aria-label="Quantité">{{ item.quantity }}</span>
                                <strong class="success-item__total">{{ (item.lineTotalCents / 100)|number_format(2, ',', ' ') }} €</strong>
                            </li>
                        {% endfor %}
                    </ul>
                </section>

                <div class="success__side">
                    <section class="success__box">
                        <h2 class="success__title">Adresse de livraison</h2>
                        <p class="success-address">
                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                            <span>
                                {{ order.shippingFullName }}<br>
                                {{ order.shippingStreet }}<br>
                                {{ order.shippingPostalCode }} {{ order.shippingCity }}<br>
                                {{ order.shippingCountry }}
                            </span>
                        </p>
                    </section>

                    <section class="success__box">
                        <h2 class="success__title">Récapitulatif de la commande</h2>
                        {% include 'cart/_summary_totals.html.twig' with {itemsCount: itemsCount, subtotalCents: order.subtotalCents, totalCents: order.totalCents} %}
                    </section>
                </div>
            </div>

            <div class="success-actions">
                {% if order.status == 'pending' %}
                    <a href="{{ path('app_checkout_pay', {id: order.orderId}) }}" class="aq-btn aq-btn--primary" data-turbo="false">Finaliser le paiement <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                {% else %}
                    <a href="{{ path('app_profile_orders_show', {id: order.orderId}) }}" class="aq-btn aq-btn--primary">Voir ma commande <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                {% endif %}
                <a href="{{ path('app_products_index') }}" class="aq-btn aq-btn--outline">Continuer mes achats</a>
            </div>
            <p class="success__note">
                {{ isPaid ? 'Un e-mail récapitulatif vous a été envoyé. ' }}Retrouvez les détails dans votre espace personnel.
            </p>
        </section>
    </div>
{% endblock %}
