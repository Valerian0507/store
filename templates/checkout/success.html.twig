{% extends 'base.html.twig' %}

{% block title %}Order confirmed
{% endblock %}

{% block body %}
	<div class="container py-5">
		<div class="mx-auto" style="max-width: 980px;">

			<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
				<div class="card-body p-4 p-md-5">

					<div class="text-center mb-5">
						<div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle bg-success text-white" style="width: 120px; height: 120px; font-size: 56px;">
							✓
						</div>

						<h1 class="fw-bold mb-3">Thank You! Your Order is Confirmed.</h1>
						<p class="text-muted fs-5 mb-0">Your order has been successfully placed.</p>
					</div>

					<hr class="mb-4">

					<div class="card rounded-4 border mb-4">
						<div class="card-header bg-white fw-semibold fs-4 py-3">
							Order Information
						</div>

						<div class="card-body p-4">
							<div class="row gy-3 mb-4">
								<div class="col-md-4">
									<div class="text-muted mb-1">Order Number:</div>
									<div class="fw-semibold">{{ order.reference }}</div>
								</div>

                                <div class="col-md-4">
                                    <div class="text-muted mb-1">Order Date:</div>
                                    <div class="fw-semibold">{{ order.createdAt|date('d/m/Y') }}</div>
                                    <div class="text-muted small">{{ order.createdAt|date('H:i') }}</div>
                                </div>

								<div class="col-md-4">
									<div class="text-muted mb-1">Status:</div>
									<span class="badge rounded-pill px-3 py-2 {{ order.statusBadgeClass }}">
										{{ order.statusLabel }}
									</span>
								</div>

								<div class="col-md-4">
									<div class="text-muted mb-1">Total:</div>
									<div class="fw-semibold">
										€
										{{ (order.totalCents / 100)|number_format(2, '.', ' ') }}
									</div>
								</div>
							</div>

							<hr>

							<div>
								<div class="fw-semibold mb-2">Shipping Address:</div>
								<div>{{ order.shippingFullName }}</div>
								<div>{{ order.shippingStreet }}</div>
								<div>{{ order.shippingCity }},
									{{ order.shippingPostalCode }},
									{{ order.shippingCountry }}</div>
							</div>
						</div>
					</div>

					<div class="card rounded-4 border">
						<div class="card-header bg-white fw-semibold fs-4 py-3">
							Items in Your Order
						</div>

						<div class="card-body p-4">
							{% if order.items is empty %}
								<p class="text-muted mb-0">No items found.</p>
							{% else %}
								{% for item in order.items %}
                                    <div class="py-3 {% if not loop.last %}border-bottom{% endif %}">
                                        <div
                                            class="d-grid align-items-start gap-3"
                                            style="grid-template-columns: minmax(0, 1fr) 90px 120px;"
                                        >
                                            <div class="d-flex gap-3" style="min-width: 0;">
                                                <div
                                                    class="rounded-3 border bg-light d-flex align-items-center justify-content-center overflow-hidden flex-shrink-0"
                                                    style="width: 110px; height: 110px;"
                                                >
                                                    {% if item.imagePath %}
                                                        <img
                                                            src="{{ asset('uploads/products/' ~ item.imagePath) }}"
                                                            alt="{{ item.productName }}"
                                                            class="img-fluid"
                                                            style="max-height: 100%; object-fit: cover;"
                                                        >
                                                    {% else %}
                                                        <span class="text-muted small">No image</span>
                                                    {% endif %}
                                                </div>

                                                <div style="min-width: 0;">
                                                    <div class="fw-semibold fs-5 mb-2" style="word-break: break-word;">
                                                        {{ item.productName }}
                                                    </div>

                                                    <div class="text-muted">
                                                        € {{ (item.unitPriceCents / 100)|number_format(2, '.', ' ') }}
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="text-center pt-1">
                                                <div class="text-muted">Qty: {{ item.quantity }}</div>
                                            </div>

                                            <div class="fw-semibold text-end pt-1">
                                                € {{ (item.lineTotalCents / 100)|number_format(2, '.', ' ') }}
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}

								<div class="d-flex justify-content-end mt-4">
									<div style="min-width: 270px;">
										<div class="d-flex justify-content-between mb-2">
											<span class="text-muted">Subtotal:</span>
											<span class="fw-semibold">€
												{{ (order.subtotalCents / 100)|number_format(2, '.', ' ') }}</span>
										</div>

										<div class="d-flex justify-content-between mb-3">
											<span class="text-muted">Shipping:</span>
											<span class="fw-semibold">€
												{{ (order.shippingCents / 100)|number_format(2, '.', ' ') }}</span>
										</div>

										<hr>

										<div class="d-flex justify-content-between fs-4 fw-bold">
											<span>Total:</span>
											<span>€
												{{ (order.totalCents / 100)|number_format(2, '.', ' ') }}</span>
										</div>
									</div>
								</div>
							{% endif %}
						</div>
					</div>

				</div>

				<div class="border-top bg-white px-4 py-4 px-md-5 d-flex flex-column flex-md-row justify-content-between gap-3">
					<a href="{{ path('app_products_index') }}" class="btn btn-outline-secondary btn-lg px-4">
						Continue Shopping
					</a>

					<button type="button" class="btn btn-success btn-lg px-4" disabled>
						View My Orders
					</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
