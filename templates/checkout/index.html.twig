{% extends 'base.html.twig' %}

{# Text field of the typed address (errors: array returned by CheckoutController::validateShippingData) #}
{% macro field(name, label, value, errors, attrs = {}) %}
    <div class="cart-field">
        <label for="{{ name }}" class="cart-field__label">{{ label }}</label>
        <input id="{{ name }}" type="text" name="{{ name }}" value="{{ value }}" required
               class="cart-input {{ errors[name] is defined ? 'is-invalid' }}"
               {% for key, val in attrs %}{{ key }}="{{ val }}" {% endfor %}>
        {% if errors[name] is defined %}<p class="cart-field__error">{{ errors[name] }}</p>{% endif %}
    </div>
{% endmacro %}

{% block title %}Finaliser ma commande - AquaSphère{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/cart.css') }}">
{% endblock %}

{% block body %}
    {% set noImage = asset('images/products/no-image.jpg') %}
    {% set useSaved = addresses is not empty and selectedAddressId > 0 %}
    {% set ownerName = (app.user.firstName ~ ' ' ~ app.user.lastName)|trim %}

    {% import _self as f %}
    {# New address fields disabled from the start when a saved address is used (even without JS) #}
    {% set off = useSaved ? {disabled: 'disabled'} : {} %}

    <div class="aq-container cart-page">
        <nav aria-label="Fil d'Ariane">
            <ol class="cart-breadcrumb">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('app_cart_index') }}">Panier</a></li>
                <li aria-current="page">Livraison</li>
            </ol>
        </nav>

        <header class="cart-head">
            <div>
                <h1 class="cart-head__title">Finaliser ma commande</h1>
                <a href="{{ path('app_cart_index') }}" class="cart-back"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour au panier</a>
            </div>
            {% include 'cart/_steps.html.twig' with {step: 2} %}
        </header>

        {% if errors is not empty %}
            <p class="cart-alert" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> Veuillez corriger les champs signalés.</p>
        {% endif %}

        <div class="cart-layout cart-layout--checkout">
            <section class="cart-card">
                <h2 class="cart-card__title">Adresse de livraison</h2>

                <form method="post" action="{{ path('app_checkout_submit') }}" id="checkout-form" data-turbo="false" data-controller="checkout-address">
                    <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">

                    {% if addresses is not empty %}
                        <div class="checkout-modes">
                            <label class="checkout-mode">
                                <input type="radio" name="addressMode" value="saved" {{ useSaved ? 'checked' }}
                                       data-checkout-address-target="mode" data-action="checkout-address#toggle">
                                Utiliser une adresse enregistrée
                            </label>
                            <label class="checkout-mode">
                                <input type="radio" name="addressMode" value="manual" {{ not useSaved ? 'checked' }}
                                       data-checkout-address-target="mode" data-action="checkout-address#toggle">
                                Nouvelle adresse
                            </label>
                        </div>

                        {# Saved addresses #}
                        <div class="checkout-saved" data-checkout-address-target="saved" {{ not useSaved ? 'hidden' }}>
                            {% for address in addresses|sort((a, b) => b.isDefault <=> a.isDefault) %}
                                <label class="checkout-address">
                                    <input type="radio" name="selectedAddress" value="{{ address.id }}"
                                           {{ (selectedAddressId == address.id or (selectedAddressId == 0 and address.isDefault)) ? 'checked' }} {{ not useSaved ? 'disabled' }}>
                                    <span>
                                        <strong>{{ ownerName ?: 'Mon adresse' }}</strong>
                                        {% if address.isDefault %}<span class="checkout-address__badge">Par défaut</span>{% endif %}
                                        <small>{{ address.street }}, {{ address.postalCode }} {{ address.city }}, {{ address.country }}</small>
                                    </span>
                                    <a href="{{ path('app_profile_addresses_edit', {id: address.id}) }}" class="checkout-address__edit">Modifier</a>
                                </label>
                            {% endfor %}
                            {% if errors is not empty and useSaved %}
                                <p class="cart-field__error">Complétez votre prénom et votre nom dans <a href="{{ path('app_profile_edit') }}">Mon profil</a>, ou saisissez une nouvelle adresse.</p>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# Nouvelle adresse (envoie selectedAddress = 0) #}
                    <div class="checkout-manual" data-checkout-address-target="manual" {{ useSaved ? 'hidden' }}>
                        <input type="hidden" name="selectedAddress" value="0" {{ useSaved ? 'disabled' }}>
                        <div class="cart-form-row">
                            {{ f.field('firstName', 'Prénom', shippingData.firstName|default(''), errors, {placeholder: 'Votre prénom', autocomplete: 'given-name', maxlength: 100}|merge(off)) }}
                            {{ f.field('lastName', 'Nom', shippingData.lastName|default(''), errors, {placeholder: 'Votre nom', autocomplete: 'family-name', maxlength: 100}|merge(off)) }}
                        </div>
                        {{ f.field('street', 'Rue et numéro', shippingData.street|default(''), errors, {placeholder: 'Nom de la rue et numéro', autocomplete: 'address-line1', maxlength: 255}|merge(off)) }}
                        <div class="cart-form-row">
                            {{ f.field('postalCode', 'Code postal', shippingData.postalCode|default(''), errors, {placeholder: 'Code postal', autocomplete: 'postal-code', maxlength: 20, inputmode: 'numeric'}|merge(off)) }}
                            {{ f.field('city', 'Ville', shippingData.city|default(''), errors, {placeholder: 'Votre ville', autocomplete: 'address-level2', maxlength: 120}|merge(off)) }}
                        </div>
                        <div class="cart-field">
                            <label for="country" class="cart-field__label">Pays</label>
                            <select id="country" name="country" class="cart-input cart-select {{ errors.country is defined ? 'is-invalid' }}" autocomplete="country-name" {{ useSaved ? 'disabled' }}>
                                {% for country in countries %}
                                    <option value="{{ country }}" {{ (shippingData.country|default('France')) == country ? 'selected' }}>{{ country }}</option>
                                {% endfor %}
                            </select>
                            {% if errors.country is defined %}<p class="cart-field__error">{{ errors.country }}</p>{% endif %}
                        </div>
                    </div>
                </form>

                <p class="cart-perk cart-perk--inline">
                    <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
                    <span><strong>Livraison offerte</strong> en France métropolitaine</span>
                </p>
            </section>

            <aside class="cart-card">
                <div class="cart-card__head">
                    <h2 class="cart-card__title">Votre commande</h2>
                    <a href="{{ path('app_cart_index') }}" class="cart-back">Modifier le panier</a>
                </div>

                <ul class="checkout-items">
                    {% for item in summary.items %}
                        <li class="checkout-item">
                            <img src="{{ item.image ? asset('uploads/products/' ~ item.image) : noImage }}" alt="" width="96" height="72" loading="lazy"
                                 onerror="this.onerror=null;this.src='{{ noImage }}';">
                            <span class="checkout-item__name">{{ item.title }}</span>
                            <span class="checkout-item__qty">Qté : {{ item.quantity }}</span>
                            <strong class="checkout-item__total">{{ (item.subtotalCents / 100)|number_format(2, ',', ' ') }} €</strong>
                        </li>
                    {% endfor %}
                </ul>

                {% include 'cart/_summary_totals.html.twig' with {itemsCount: summary.itemsCount, subtotalCents: summary.subtotalCents, totalCents: summary.totalCents} %}

                {# Button of the left-hand form (form attribute) #}
                <button type="submit" form="checkout-form" class="aq-btn aq-btn--primary aq-btn--block cart-cta">
                    Continuer vers le paiement <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
                <p class="cart-secure"><i class="fa-solid fa-lock" aria-hidden="true"></i> Vous serez redirigé vers Stripe pour régler votre commande.</p>
                <p class="cart-cards" aria-label="Cartes acceptées"><i class="fa-brands fa-cc-visa" aria-hidden="true"></i> <i class="fa-brands fa-cc-mastercard" aria-hidden="true"></i></p>
            </aside>
        </div>
    </div>
{% endblock %}
