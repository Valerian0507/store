{% extends 'base.html.twig' %}

{% block title %}Checkout{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4">Checkout</h1>

    {% if errors is not empty %}
        <div class="alert alert-danger" role="alert">
            Please correct the highlighted fields.
        </div>
    {% endif %}

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h4 mb-3">Shipping information</h2>

                    <form method="post" action="{{ path('app_checkout_submit') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="firstName" class="form-label">First name</label>
                                <input
                                    id="firstName"
                                    type="text"
                                    name="firstName"
                                    class="form-control {{ errors.firstName is defined ? 'is-invalid' : '' }}"
                                    value="{{ shippingData.firstName|default('') }}"
                                    autocomplete="given-name"
                                    maxlength="100"
                                    required
                                >
                                {% if errors.firstName is defined %}
                                    <div class="invalid-feedback">
                                        {{ errors.firstName }}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-md-6">
                                <label for="lastName" class="form-label">Last name</label>
                                <input
                                    id="lastName"
                                    type="text"
                                    name="lastName"
                                    class="form-control {{ errors.lastName is defined ? 'is-invalid' : '' }}"
                                    value="{{ shippingData.lastName|default('') }}"
                                    autocomplete="family-name"
                                    maxlength="100"
                                    required
                                >
                                {% if errors.lastName is defined %}
                                    <div class="invalid-feedback">
                                        {{ errors.lastName }}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-12">
                                <label for="street" class="form-label">Street</label>
                                <input
                                    id="street"
                                    type="text"
                                    name="street"
                                    class="form-control {{ errors.street is defined ? 'is-invalid' : '' }}"
                                    value="{{ shippingData.street|default('') }}"
                                    autocomplete="address-line1"
                                    maxlength="255"
                                    required
                                >
                                {% if errors.street is defined %}
                                    <div class="invalid-feedback">
                                        {{ errors.street }}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-md-6">
                                <label for="city" class="form-label">City</label>
                                <input
                                    id="city"
                                    type="text"
                                    name="city"
                                    class="form-control {{ errors.city is defined ? 'is-invalid' : '' }}"
                                    value="{{ shippingData.city|default('') }}"
                                    autocomplete="address-level2"
                                    maxlength="120"
                                    required
                                >
                                {% if errors.city is defined %}
                                    <div class="invalid-feedback">
                                        {{ errors.city }}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-md-3">
                                <label for="postalCode" class="form-label">Postal code</label>
                                <input
                                    id="postalCode"
                                    type="text"
                                    name="postalCode"
                                    class="form-control {{ errors.postalCode is defined ? 'is-invalid' : '' }}"
                                    value="{{ shippingData.postalCode|default('') }}"
                                    autocomplete="postal-code"
                                    maxlength="20"
                                    required
                                >
                                {% if errors.postalCode is defined %}
                                    <div class="invalid-feedback">
                                        {{ errors.postalCode }}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-md-3">
                                <label for="country" class="form-label">Country</label>
                                <input
                                    id="country"
                                    type="text"
                                    name="country"
                                    class="form-control {{ errors.country is defined ? 'is-invalid' : '' }}"
                                    value="{{ shippingData.country|default('') }}"
                                    autocomplete="country-name"
                                    maxlength="120"
                                    required
                                >
                                {% if errors.country is defined %}
                                    <div class="invalid-feedback">
                                        {{ errors.country }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary mt-4">
                            Place order
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h4 mb-3">Order summary</h2>

                    {% if summary.isEmpty() %}
                        <p class="text-muted mb-0">Your cart is empty.</p>
                    {% else %}
                        <div class="mb-3">
                            {% for item in summary.items %}
                                <div class="d-flex gap-3 py-3 border-bottom">
                                    <div style="width: 72px; flex: 0 0 72px;">
                                        {% if item.image %}
                                            <img
                                                src="{{ asset('uploads/products/' ~ item.image) }}"
                                                alt="{{ item.title }}"
                                                class="img-fluid rounded"
                                            >
                                        {% else %}
                                            <img
                                                src="{{ asset('images/product-placeholder.jpg') }}"
                                                alt="No image"
                                                class="img-fluid rounded"
                                            >
                                        {% endif %}
                                    </div>

                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">{{ item.title }}</div>
                                        <div class="text-muted small">
                                            Qty: {{ item.quantity }}
                                        </div>
                                        <div class="text-muted small">
                                            Unit price: {{ (item.unitPriceCents / 100)|number_format(2, '.', ' ') }} €
                                        </div>
                                    </div>

                                    <div class="text-end fw-semibold">
                                        {{ (item.subtotalCents / 100)|number_format(2, '.', ' ') }} €
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Items</span>
                            <span>{{ summary.itemsCount }}</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>{{ (summary.subtotalCents / 100)|number_format(2, '.', ' ') }} €</span>
                        </div>

                        <div class="d-flex justify-content-between fw-bold fs-5 pt-2 border-top">
                            <span>Total</span>
                            <span>{{ (summary.totalCents / 100)|number_format(2, '.', ' ') }} €</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
