{% extends 'base.html.twig' %}

{% block title %}Checkout
{% endblock %}

{% block stylesheets %}
    <style>
        .checkout-item-title{
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .checkout-address-option {
            display: flex;
            align-items: flex-start;
            gap: 0.9rem;
            padding: 0.25rem 0;
            cursor: pointer;
        }

        .checkout-address-option__radio {
            padding-top: 0.2rem;
        }

        .checkout-address-option__content {
            color: #0f1111;
            line-height: 1.45;
        }

        .checkout-selected-address {
            padding-bottom: 1rem;
            border-bottom: 1px solid #eaeded;
        }

        .checkout-change-link {
            background: none;
            border: 0;
            padding: 0;
            color: #2162a1;
            cursor: pointer;
            text-decoration: none;
        }

        .checkout-change-link:hover {
            color: #c7511f;
            text-decoration: underline;
        }

        .checkout-addresses-panel {
            padding-top: 0.5rem;
        }
    </style>
{% endblock %}

{% block body %}
	<div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">

    		<h1 class="">Passer la commande</h1>
            <a href="{{ path('app_cart_index') }}" class="btn btn-outline-secondary">
				Retour
			</a>
        </div>

		{% if errors is not empty %}
			<div class="alert alert-danger" role="alert">
				Veuillez corriger les champs en surbrillance.
			</div>
		{% endif %}

		<div class="row g-4">
			<div class="col-12 col-lg-7">
				<div class="card shadow-sm">
					<div class="card-body">
						<h2 class="h4 mb-3">Adresses de livraison</h2>
						<form method="post" action="{{ path('app_checkout_submit') }}" data-turbo="false" data-controller="checkout-address">
							<input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
							{% set useManualAddress = selectedAddressId == 0 %}
							{% if addresses is not empty %}
								<div class="checkout-selected-address mb-3 {% if useManualAddress %}d-none{% endif %}" id="checkout-selected-address">
                                	<div class="d-flex justify-content-between align-items-start gap-3">
										<div>
											<div class="fw-semibold mb-1">
												Livraison à
												<span id="checkout-current-fullname">
													{% if currentAddress is not null and (currentAddress.user.firstName or currentAddress.user.lastName) %}
														{{ currentAddress.user.firstName }}
														{{ currentAddress.user.lastName }}
													{% else %}
														Propriétaire du compte
													{% endif %}
												</span>
											</div>

											<div class="text-muted" id="checkout-current-address-line">
												{% if currentAddress is not null %}
													{{ currentAddress.street }},
													{{ currentAddress.city }},
													{{ currentAddress.postalCode }},
													{{ currentAddress.country }}
												{% endif %}
											</div>

											<div class="text-muted small mt-1 {% if currentAddress is null or not currentAddress.isDefault %}d-none{% endif %}" id="checkout-current-default-badge">
												Adresse par défaut
											</div>
										</div>

										<button type="button" class="checkout-change-link" id="checkout-change-address">
											Modifier
										</button>
									</div>
								</div>

								<div class="checkout-addresses-panel mb-3 d-none" id="checkout-addresses-panel">
										<h3 class="h5 mb-3">Adresses de livraison ({{ addresses|length }})</h3>

										<div class="d-flex flex-column gap-3">
											{% for address in addresses %}
												<label class="checkout-address-option">
													<div class="checkout-address-option__radio">
														<input type="radio" name="selectedAddress" value="{{ address.id }}" data-first-name="{{ address.user.firstName|default('') }}" data-last-name="{{ address.user.lastName|default('') }}" data-street="{{ address.street }}" data-city="{{ address.city }}" data-postal-code="{{ address.postalCode }}" data-country="{{ address.country }}" data-is-default="{{ address.isDefault ? '1' : '0' }}" {% if selectedAddressId == address.id %} checked {% endif %}>
													</div>

													<div class="checkout-address-option__content">
														<div class="fw-semibold">
															{% if address.user.firstName or address.user.lastName %}
																{{ address.user.firstName }}
																{{ address.user.lastName }}
															{% else %}
																Propriétaire du compte
															{% endif %}
														</div>

														<div>
															{{ address.street }},
															{{ address.city }},
															{{ address.postalCode }},
															{{ address.country }}
														</div>

														<div class="mt-1 d-flex gap-2 flex-wrap">
															<a href="{{ path('app_profile_addresses_edit', { id: address.id }) }}" class="small text-decoration-none">
																Modifier l'adresse
															</a>
														</div>

														{% if address.isDefault %}
															<div class="text-muted small mt-1">Adresse par défaut</div>
														{% endif %}
													</div>
												</label>
											{% endfor %}

											<div class="mt-3">
												<button type="button" class="checkout-change-link" id="checkout-add-address">
													Ajouter l'adresse
												</button>

												<input type="radio" name="selectedAddress" value="0" id="selectedAddressManual" class="d-none" {% if selectedAddressId == 0 %} checked {% endif %}>
											</div>
										</div>
								</div>
							{% endif %}
                            {% if addresses is not empty %}
                                <div class="{% if not useManualAddress %}d-none{% endif %} mb-3" id="checkout-manual-actions">
                                    <button type="button" class="checkout-change-link" id="checkout-use-saved-addresses">
                                        Utiliser l'adresse enregistrée
                                    </button>
                                </div>
                            {% endif %}

							<div class="row g-3 {% if not useManualAddress %}d-none{% endif %}" id="checkout-manual-address-fields">
								<div class="col-md-6">
									<label for="firstName" class="form-label">Prénom</label>
									<input id="firstName" type="text" name="firstName" class="js-manual-address-field form-control {{ errors.firstName is defined ? 'is-invalid' : '' }}" value="{{ shippingData.firstName|default('') }}" autocomplete="given-name" maxlength="100" required>
									{% if errors.firstName is defined %}
										<div class="invalid-feedback">
											{{ errors.firstName }}
										</div>
									{% endif %}
								</div>

								<div class="col-md-6">
									<label for="lastName" class="form-label">Nom</label>
									<input id="lastName" type="text" name="lastName" class="js-manual-address-field form-control {{ errors.lastName is defined ? 'is-invalid' : '' }}" value="{{ shippingData.lastName|default('') }}" autocomplete="family-name" maxlength="100" required>
									{% if errors.lastName is defined %}
										<div class="invalid-feedback">
											{{ errors.lastName }}
										</div>
									{% endif %}
								</div>

								<div class="col-12">
									<label for="street" class="form-label">Rue</label>
									<input id="street" type="text" name="street" class="js-manual-address-field form-control {{ errors.street is defined ? 'is-invalid' : '' }}" value="{{ shippingData.street|default('') }}" autocomplete="address-line1" maxlength="255" required>
									{% if errors.street is defined %}
										<div class="invalid-feedback">
											{{ errors.street }}
										</div>
									{% endif %}
								</div>

								<div class="col-md-6">
									<label for="city" class="form-label">Ville</label>
									<input id="city" type="text" name="city" class="js-manual-address-field form-control {{ errors.city is defined ? 'is-invalid' : '' }}" value="{{ shippingData.city|default('') }}" autocomplete="address-level2" maxlength="120" required>
									{% if errors.city is defined %}
										<div class="invalid-feedback">
											{{ errors.city }}
										</div>
									{% endif %}
								</div>

								<div class="col-md-3">
									<label for="postalCode" class="form-label">Code postal</label>
									<input id="postalCode" type="text" name="postalCode" class="js-manual-address-field form-control {{ errors.postalCode is defined ? 'is-invalid' : '' }}" value="{{ shippingData.postalCode|default('') }}" autocomplete="postal-code" maxlength="20" required>
									{% if errors.postalCode is defined %}
										<div class="invalid-feedback">
											{{ errors.postalCode }}
										</div>
									{% endif %}
								</div>

								<div class="col-md-3">
									<label for="country" class="form-label">Pays</label>
									<input id="country" type="text" name="country" class="js-manual-address-field form-control {{ errors.country is defined ? 'is-invalid' : '' }}" value="{{ shippingData.country|default('') }}" autocomplete="country-name" maxlength="120" required>
									{% if errors.country is defined %}
										<div class="invalid-feedback">
											{{ errors.country }}
										</div>
									{% endif %}
								</div>
							</div>

							<button type="submit" class="btn btn-primary mt-3">
								Passer la commande
							</button>
						</form>
					</div>
				</div>
			</div>

			<div class="col-12 col-lg-5">
				<div class="card shadow-sm">
					<div class="card-body">
						<h2 class="h4 mb-3">Récapitulatif de la commande</h2>

						{% if summary.isEmpty() %}
							<p class="text-muted mb-0">Your cart is empty.</p>
						{% else %}
							<div class="mb-3">
								{% for item in summary.items %}
									<div class="d-flex gap-3 py-3 border-bottom">
										<div style="width: 72px; flex: 0 0 72px;">
											{% if item.image %}
												<img src="{{ asset('uploads/products/' ~ item.image) }}" alt="{{ item.title }}" class="img-fluid rounded" style="width: 72px; height: 72px; object-fit: contain;">
											{% else %}
												<img src="{{ asset('uploads/products/no-image.jpg') }}" alt="No image" class="img-fluid rounded" style="width: 72px; height: 72px; object-fit: cover;">
											{% endif %}
										</div>

										<div class="flex-grow-1">
											<div class="fw-semibold checkout-item-title">{{ item.title }}</div>
											<div class="text-muted small">
												Qty:
												{{ item.quantity }}
											</div>
											<div class="text-muted small">
												Prix unitaire:
												{{ (item.unitPriceCents / 100)|number_format(2, '.', ' ') }}
												€
											</div>
										</div>

										<div class="text-end fw-semibol flex-shrink-0 text-nowrap" style="width: 110px;">
											{{ (item.subtotalCents / 100)|number_format(2, '.', ' ') }}
											€
										</div>
									</div>
								{% endfor %}
							</div>

							<div class="d-flex justify-content-between mb-2">
								<span>Articles</span>
								<span>{{ summary.itemsCount }}</span>
							</div>

							<div class="d-flex justify-content-between mb-2">
								<span>Sous-Total</span>
								<span>{{ (summary.subtotalCents / 100)|number_format(2, '.', ' ') }}
									€</span>
							</div>

							<div class="d-flex justify-content-between fw-bold fs-5 pt-2 border-top">
								<span>Total</span>
								<span>{{ (summary.totalCents / 100)|number_format(2, '.', ' ') }}
									€</span>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
