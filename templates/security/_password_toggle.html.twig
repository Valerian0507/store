{# "Eye" button to place in an .auth-field__password (password_toggle_controller.js) #}
<button type="button" class="auth-field__eye" data-password-toggle-target="button" data-action="password-toggle#toggle"
        aria-label="Afficher le mot de passe" aria-pressed="false">
    <i class="fa-regular fa-eye" data-password-toggle-target="icon" aria-hidden="true"></i>
</button>
