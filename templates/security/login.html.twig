{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Connexion - AquaSphère{% endblock %}

{% block auth_content %}
    <p class="aq-kicker">Votre espace AquaSphère</p>
    <h1 class="auth__title">Heureux de vous revoir.</h1>
    <p class="auth__subtitle">Connectez-vous pour retrouver votre compte.</p>

    {% if error %}
        <div class="auth__error" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <div>
                {{ error.messageKey|trans(error.messageData, 'security') }}
                {% if error.messageKey == 'error.email_not_verified' %}
                    <a href="{{ path('app_resend_verify_email') }}">Renvoyer l’e-mail de vérification</a>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <form method="post" class="auth-form">
        <div class="auth-field">
            <label for="email" class="auth-field__label">E-mail</label>
            <input type="email" value="{{ last_username }}" name="email" id="email" class="auth-field__input"
                   autocomplete="email" required autofocus placeholder="votre@email.com">
        </div>

        <div class="auth-field">
            <label for="password" class="auth-field__label">Mot de passe</label>
            <div class="auth-field__password" data-controller="password-toggle">
                <input type="password" name="password" id="password" class="auth-field__input"
                       autocomplete="current-password" required placeholder="Votre mot de passe" data-password-toggle-target="input">
                {% include 'security/_password_toggle.html.twig' %}
            </div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="auth-form__row">
            <label class="auth-check">
                <input type="checkbox" name="_remember_me" class="auth-check__input">
                <span>Se souvenir de moi</span>
            </label>
            <a href="{{ path('app_forgot_password_request') }}" class="auth__link">Mot de passe oublié ?</a>
        </div>

        <button class="aq-btn aq-btn--primary aq-btn--block auth-form__submit" type="submit">
            Connexion <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
    </form>

    <p class="auth__switch">
        Pas encore de compte ? <a href="{{ path('app_register') }}" class="auth__link">Créer un compte</a>
    </p>
{% endblock %}
