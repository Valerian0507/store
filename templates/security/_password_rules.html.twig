{# Règles du mot de passe (password_rules_controller.js) - à placer dans un bloc data-controller="password-rules" #}
<ul class="password-rules" id="password-rules">
    <li data-password-rules-target="rule" data-rule="length">8 caractères minimum</li>
    <li data-password-rules-target="rule" data-rule="upper">Une majuscule</li>
    <li data-password-rules-target="rule" data-rule="digit">Un chiffre</li>
    <li data-password-rules-target="rule" data-rule="special">Un caractère spécial</li>
</ul>
