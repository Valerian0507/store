{% extends 'base.html.twig' %}

{% block title %}{{ product.title }}{% endblock %}

{% block body %}
    <a href="{{ path('app_products_index') }}">← Retourner au catalogue</a>

    <section  class="container">
        {% if product.image %}
            <img class="img-fluid" src="{{ asset('uploads/products/' ~ product.image) }}"
                 alt="{{ product.title }}"
                 onerror="this.onerror=null;this.src='{{ asset('images/products/no-image.jpg') }}';"
                 >
        {% else %}
            <img class="img-fluid" src="{{ asset('images/products/no-image.jpg') }}"
                 alt="No image">
        {% endif %}

        {#        {% if product.image %}#}
{#             <img class="img-fluid" src="{{ asset('images/products/' ~ product.image) }}">#}
{#        {% endif %}#}
        <h2>{{ product.title }}</h2>

        <p><b>Prix:</b> {{ product.getPriceEur() }}</p>
        <p><b>Catégorie:</b> {{ product.category }}</p>
        <p><b>Reference:</b> {{ product.reference }}</p>

        {% if product.description %}
            <h3>Description</h3>
            <p>{{ product.description }}</p>
        {% endif %}

        <h3>Caractéristiques</h3>
        <ul>
            <li>Volume (м³): {{ product.volumeM3 }}</li>
            <li>Poids (kg): {{ product.weightKg }}</li>
        </ul>
    </section>
    <form method="post" action="{{ path('app_cart_add', { id: product.id }) }}">
        <input type="number" name="qty" value="1" min="1">
        <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
        <button type="submit">Ajouter au panier</button>
    </form>

{% endblock %}
