{% extends 'base.html.twig' %}

{% block title %}{{ product.title }}{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/pages/product-show.css') }}">
{% endblock %}

{% block body %}
    <section class="container py-4">
        <a href="{{ path('app_products_index') }}" class="product-show__back">
            ← Retour au catalogue
        </a>

        <div class="product-show__layout">
            <div class="product-show__media">
                <div class="product-show__image-wrap">
                    {% if product.image %}
                        <img
                            src="{{ asset('uploads/products/' ~ product.image) }}"
                            alt="{{ product.title }}"
                            class="product-show__image"
                            onerror="this.onerror=null;this.src='{{ asset('images/products/no-image.jpg') }}';"
                        >
                    {% else %}
                        <img
                            src="{{ asset('images/products/no-image.jpg') }}"
                            alt="No image"
                            class="product-show__image"
                        >
                    {% endif %}
                </div>
            </div>

            <aside class="product-show__panel">
                <h1 class="product-show__title">{{ product.title }}</h1>

                <p class="product-show__ref">
                    Référence : {{ product.reference }}
                </p>

                {% if product.stock > 0 %}
                    <div class="product-show__status product-show__status--ok">
                        En stock
                    </div>
                    <p class="product-show__delivery">Disponible immédiatement</p>
                {% else %}
                    <div class="product-show__status product-show__status--out">
                        Rupture de stock
                    </div>
                    <p class="product-show__delivery">Produit actuellement indisponible</p>
                {% endif %}

                <div class="product-show__price">
                    {{ product.getPriceEur() }} €
                </div>
                    <p class="product-show__delivery">Livraison gratuit</p>

                {# <ul class="product-show__meta">
                    <li>
                        <strong>Catégorie :</strong>
                        {{ product.category ? product.category.label : '—' }}
                    </li>
                    <li>
                        <strong>Volume (m³) :</strong>
                        {{ product.volumeM3 is not null ? product.volumeM3 : '—' }}
                    </li>
                    <li>
                        <strong>Poids (kg) :</strong>
                        {{ product.weightKg is not null ? product.weightKg : '—' }}
                    </li>
                </ul> #}

                <div class="product-show__buy-box">
                    <form method="post" action="{{ path('app_cart_add', { id: product.id }) }}" class="product-show__form">
                        <input
                            type="number"
                            name="qty"
                            value="1"
                            min="1"
                            class="product-show__qty"
                            {% if product.stock < 1 %}disabled{% endif %}
                        >
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">

                        <button
                            type="submit"
                            class="product-show__submit"
                            {% if product.stock < 1 %}disabled{% endif %}
                        >
                            Ajouter au panier
                        </button>
                    </form>
                </div>
            </aside>
        </div>

        <div class="product-show__details">
            {% if product.description %}
                <section class="product-show__section">
                    <h2 class="product-show__section-title">Description</h2>
                    <p class="product-show__description">
                        {{ product.description }}
                    </p>
                </section>
            {% endif %}

            <section class="product-show__section">
                <h2 class="product-show__section-title">Caractéristiques</h2>
                <ul class="product-show__features">
                    <li>Catégorie : {{ product.category ? product.category.label : '—' }}</li>
                    <li>Référence : {{ product.reference }}</li>
                    <li>Volume (m³) : {{ product.volumeM3 is not null ? product.volumeM3 : '—' }}</li>
                    <li>Poids (kg) : {{ product.weightKg is not null ? product.weightKg : '—' }}</li>
                </ul>
            </section>
        </div>
    </section>
{% endblock %}
