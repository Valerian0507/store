{% extends 'base.html.twig' %}

{% set selectedCategory = categories|filter(c => c.id == category)|first %}
{% set pageTitle = selectedCategory ? selectedCategory.label|capitalize : 'Tous les produits' %}

{% block title %}{{ pageTitle }} - AquaSphère{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/pages/product-index.css') }}">
{% endblock %}

{% block body %}
	<section class="aq-container catalog">
		<header class="catalog__head">
			<h1 class="catalog__title">{{ pageTitle }}</h1>
			<p class="catalog__count">
				{{ total }} résultat{{ total > 1 ? 's' }}
				{% if q %}pour « <strong>{{ q }}</strong> »{% endif %}
			</p>

			{# Useful tool depending on the category (PoolToolsController) #}
			{% if selectedCategory %}
				{% if selectedCategory.label|lower == 'piscines' %}
					<a class="aq-link-arrow catalog__tool" href="{{ path('app_tools_volume') }}">
						Besoin de connaître le volume ? Ouvrir le calculateur <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
					</a>
				{% elseif selectedCategory.label|lower in ['spa', 'entretien'] %}
					<a class="aq-link-arrow catalog__tool" href="{{ path('app_tools_water') }}">
						Comprendre mes mesures d’eau <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
					</a>
				{% endif %}
			{% endif %}
		</header>

		<form method="get" class="catalog-filters" role="search">
			<label class="catalog-filters__field">
				<span class="catalog-filters__label">Catégorie</span>
				<select name="category" class="catalog-filters__control catalog-filters__select" onchange="this.form.submit()">
					<option value="">Toutes les catégories</option>
					{% for c in nav_categories() %}
						<option value="{{ c.id }}" {{ c.id == category ? 'selected' }}>{{ c.label|capitalize }}</option>
					{% endfor %}
				</select>
			</label>

			<label class="catalog-filters__field">
				<span class="catalog-filters__label">Rechercher un produit</span>
				<span class="catalog-filters__search">
					<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
					<input type="search" name="q" value="{{ q ?? '' }}" placeholder="Nom ou référence…" maxlength="80"
						   class="catalog-filters__control catalog-filters__input">
				</span>
			</label>

			<label class="catalog-filters__field">
				<span class="catalog-filters__label">Trier par</span>
				<select name="sort" class="catalog-filters__control catalog-filters__select" onchange="this.form.submit()">
					{% for value, label in {
						newest: 'Nouveautés',
						price_asc: 'Prix croissant',
						price_desc: 'Prix décroissant',
						title_asc: 'Nom de A à Z',
						title_desc: 'Nom de Z à A',
					} %}
						<option value="{{ value }}" {{ sort == value ? 'selected' }}>{{ label }}</option>
					{% endfor %}
				</select>
			</label>

			<button type="submit" class="aq-btn aq-btn--primary catalog-filters__submit">Rechercher</button>
		</form>

		{% set baseParams = {} %}
		{% if category %}
			{% set baseParams = baseParams|merge({category: category}) %}
		{% endif %}
		{% if sort %}
			{% set baseParams = baseParams|merge({sort: sort}) %}
		{% endif %}
		{% if q %}
			{% set baseParams = baseParams|merge({q: q}) %}
		{% endif %}

		{% if products is empty %}
			<div class="catalog__empty">
				<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
				{% if q %}
					<p>Aucun produit trouvé pour « <strong>{{ q }}</strong> ».</p>
				{% else %}
					<p>Aucun produit disponible pour le moment.</p>
				{% endif %}
				<a href="{{ path('app_products_index') }}" class="aq-btn aq-btn--outline aq-btn--sm">Voir tous les produits</a>
			</div>
		{% else %}
			<div class="catalog__grid">
				{% for product in products %}
					{% include '_partials/_product_card.html.twig' with {product: product, catalog: true} %}
				{% endfor %}
			</div>

			{% if pages > 1 %}
				<nav class="catalog-pagination" aria-label="Pagination">
					{% if page > 1 %}
						<a href="{{ path('app_products_index', baseParams|merge({page: page - 1})) }}" class="catalog-pagination__item" aria-label="Page précédente">
							<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
						</a>
					{% endif %}

					<a href="{{ path('app_products_index', baseParams|merge({page: 1})) }}" class="catalog-pagination__item {{ page == 1 ? 'is-current' }}" {% if page == 1 %}aria-current="page"{% endif %}>1</a>

					{% if pagination.start > 2 %}
						<span class="catalog-pagination__dots" aria-hidden="true">…</span>
					{% endif %}

					{% for p in pagination.start..pagination.end %}
						{% if p > 1 and p < pages %}
							<a href="{{ path('app_products_index', baseParams|merge({page: p})) }}" class="catalog-pagination__item {{ page == p ? 'is-current' }}" {% if page == p %}aria-current="page"{% endif %}>{{ p }}</a>
						{% endif %}
					{% endfor %}

					{% if pagination.end < pages - 1 %}
						<span class="catalog-pagination__dots" aria-hidden="true">…</span>
					{% endif %}

					<a href="{{ path('app_products_index', baseParams|merge({page: pages})) }}" class="catalog-pagination__item {{ page == pages ? 'is-current' }}" {% if page == pages %}aria-current="page"{% endif %}>{{ pages }}</a>

					{% if page < pages %}
						<a href="{{ path('app_products_index', baseParams|merge({page: page + 1})) }}" class="catalog-pagination__item" aria-label="Page suivante">
							<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
						</a>
					{% endif %}
				</nav>
			{% endif %}
		{% endif %}
	</section>
{% endblock %}
