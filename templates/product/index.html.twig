{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/pages/product-index.css') }}">
{% endblock %}

{% block body %}
	<section class="container py-4">
		<h1 class="products-page__title">Catalogue des produits</h1>

		<form method="get" class="products-page__filters">
			<label class="products-page__field">
				<span class="products-page__label">Catégorie</span>
				<select name="category" class="products-page__select" onchange="this.form.submit()">
					<option value="">Toutes</option>{% for c in categories %}
						<option value="{{ c.id }}" {{ c.id == category ? 'selected' : '' }}>
							{{ c.label|capitalize }}
						</option>
					{% endfor %}
				</select>
			</label>

			<label class="products-page__field">
				<span class="products-page__label">Recherche</span>
				<input type="search" name="q" value="{{ q ?? '' }}" placeholder="Nom du produit" class="products-page__input">
			</label>

			<label class="products-page__field">
				<span class="products-page__label">Trier</span>
				<select name="sort" class="products-page__select" onchange="this.form.submit()">
					<option value="newest" {% if sort == 'newest' %} selected {% endif %}>Nouveautés</option>
					<option value="price_asc" {% if sort == 'price_asc' %} selected {% endif %}>Prix ↑</option>
					<option value="price_desc" {% if sort == 'price_desc' %} selected {% endif %}>Prix ↓</option>
					<option value="title_asc" {% if sort == 'title_asc' %} selected {% endif %}>Titre A→Z</option>
					<option value="title_desc" {% if sort == 'title_desc' %} selected {% endif %}>Titre Z→A</option>
				</select>
			</label>

			<button type="submit" class="products-page__submit">Rechercher</button>
		</form>

		{% set baseParams = {} %}
		{% if category %}
			{% set baseParams = baseParams|merge({category: category}) %}
		{% endif %}
		{% if sort %}
			{% set baseParams = baseParams|merge({sort: sort}) %}
		{% endif %}
		{% if q %}
			{% set baseParams = baseParams|merge({q: q}) %}
		{% endif %}

		{% if products is empty %}
			{% if q %}
				<p class="products-page__empty">Aucun produit trouvé pour «
					<strong>{{ q }}</strong>
					».</p>
			{% else %}
				<p class="products-page__empty">Aucun produit disponible.</p>
			{% endif %}
		{% else %}
			<div class="products-grid">
				{% for product in products %}
					<article class="product-card">
						<a href="{{ path('app_products_show', {id: product.id}) }}" class="product-card__image-link">
							{% if product.image %}
								<img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.title }}" onerror="this.onerror=null;this.src='{{ asset('images/products/no-image.jpg') }}';">
							{% else %}
								<img src="{{ asset('images/products/no-image.jpg') }}" alt="No image">
							{% endif %}
						</a>

						<div class="product-card__meta">
							<h2 class="product-card__title">
								<a href="{{ path('app_products_show', {id: product.id}) }}">{{ product.title }}</a>
							</h2>

							<p class="product-card__ref">Réf :
								{{ product.reference }}</p>
							<p class="product-card__price">Prix :
								{{ product.getPriceEur() }}
								€</p>
							<div class="product-card__actions">
								<form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
									<button type="submit" class="product-card__add-button">
                                        Ajouter au panier
                                    </button>
								</form>
							</div>
						</div>

					</article>
				{% endfor %}
			</div>

			{% if pages > 1 %}
				<nav class="paginated">
					{% if page > 1 %}
						<a href="{{ path('app_products_index', baseParams|merge({page: page - 1})) }}" class="previous">‹</a>
					{% endif %}

					<a href="{{ path('app_products_index', baseParams|merge({page: 1})) }}" class="{{ page == 1 ? 'is-current' : '' }}">1</a>

					{% if pagination.start > 2 %}
						<span class="dots">…</span>
					{% endif %}

					{% for p in pagination.start..pagination.end %}
						{% if p > 1 and p < pages %}
							<a href="{{ path('app_products_index', baseParams|merge({page: p})) }}" class="{{ page == p ? 'is-current' : '' }}">{{ p }}</a>
						{% endif %}
					{% endfor %}

					{% if pagination.end < pages - 1 %}
						<span class="dots">…</span>
					{% endif %}

					<a href="{{ path('app_products_index', baseParams|merge({page: pages})) }}" class="{{ page == pages ? 'is-current' : '' }}">{{ pages }}</a>

					{% if page < pages %}
						<a href="{{ path('app_products_index', baseParams|merge({page: page + 1})) }}" class="next">›</a>
					{% endif %}
				</nav>
			{% endif %}
		{% endif %}
	</section>
{% endblock %}
